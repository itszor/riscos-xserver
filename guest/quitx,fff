10 REM Send Message_Quit to the Wimp task named in QuitTask$Name
20 REM (default "X server"), as Task Manager's Quit does.
30 DIM b% 64, m% 256, v% 256
40 SYS "XOS_ReadVarVal","QuitTask$Name",v%,255,0,3 TO ,,len%;flags%
50 IF (flags% AND 1) OR len%=0 THEN want$="X server" ELSE v%?len%=13: want$=$v%
60 next%=0: handle%=0
70 REPEAT
80   SYS "TaskManager_EnumerateTasks",next%,b%,16 TO next%
90   IF b%!0<>0 THEN
100     n$="": p%=b%!4: WHILE ?p%>=32: n$+=CHR$?p%: p%+=1: ENDWHILE
110     IF n$=want$ THEN handle%=b%!0
120   ENDIF
130 UNTIL next%<0
140 IF handle%=0 THEN PRINT want$;" is not running": END
150 m%!0=20: m%!12=0: m%!16=0
160 SYS "Wimp_SendMessage",17,m%,handle%
170 PRINT "sent Message_Quit to ";want$;" (task &";~handle%;")"
