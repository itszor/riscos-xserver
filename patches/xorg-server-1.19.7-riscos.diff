+
+Bool
+riscosEnable(ScreenPtr pScreen)
+{
+    /* A new generation starts with a cleared framebuffer: show it. */
+    if (rd.window)
+        _swix(Wimp_ForceRedraw, _INR(0, 4), rd.window,
+              0, -(rd.height << rd.yeig), rd.width << rd.xeig, 0);
+    return TRUE;
+}
