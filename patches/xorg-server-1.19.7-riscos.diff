--- a/hw/kdrive/riscos/riscos.c	1970-01-01 01:00:00.000000000 +0100
+++ b/hw/kdrive/riscos/riscos.c	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,1392 @@
+/*
+ * Xriscos: the kdrive X server for the RISC OS desktop.
+ *
+ * The X screen is a 16bpp (or 32bpp) RISC OS sprite. fb draws straight into
+ * the sprite's pixels: RISC OS keeps red in the low bits, so the X visual's
+ * masks are chosen to match and nothing is converted. The sprite is shown in a
+ * Wimp window. The shadow layer's damage tracking turns each change into
+ * Wimp_ForceRedraw; the Wimp then asks for the area to be redrawn and the
+ * sprite is plotted with OS_SpriteOp PutSpriteScaled.
+ *
+ * The window and sprite are made once and kept across server generations,
+ * since kdrive calls the card and screen functions again on every reset.
+ *
+ * Resizing the window resizes the X screen: once the window's size has been
+ * steady for RESIZE_SETTLE_MS, a work procedure swaps in a sprite of the new
+ * size and tells X and its clients (RandR), as Xephyr does for its host
+ * window. The work area is as big as the desktop, so the window can grow to
+ * that; it has no scroll bars, since the X screen always fills it.
+ *
+ * Full screen (the icon bar menu, or Alt+Return) does without the sprite: a
+ * window with no furniture covers the desktop, and X draws straight into
+ * screen memory, at the desktop's size and depth. Nothing is plotted; when
+ * the Wimp asks for part of that window to be redrawn (after an error box,
+ * say), X is asked to repaint it, as for exposed windows. While X runs the
+ * screen is made cacheable (vcache.c).
+ *
+ * Rootless mode (rootless.c, the Rootless option) has no such window: each
+ * top-level X window is a RISC OS window of its own, and the X screen is
+ * the desktop.
+ *
+ * Based on hw/kdrive/fake (Keith Packard).
+ */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include <signal.h>
+#include <string.h>
+#include <kernel.h>
+#include <swis.h>
+#include <rwl.h>
+#include "riscos.h"
+#include "shadow.h"
+#include "opaque.h"             /* display */
+#include "extinit.h"            /* noCompositeExtension */
+#include "windowstr.h"
+#include "inputstr.h"
+
+/* Wimp event reason codes and messages */
+#define Redraw_Window_Request   1
+#define Open_Window_Request     2
+#define Close_Window_Request    3
+#define Pointer_Leaving_Window  4
+#define Pointer_Entering_Window 5
+#define Mouse_Click             6
+#define Menu_Selection          9
+#define Key_Pressed             8
+#define Lose_Caret              11
+#define Gain_Caret              12
+#define User_Message            17
+#define User_Message_Recorded   18
+#define Message_ModeChange      0x400c1
+
+/* How often the pointer is read while it is over the window. */
+#define POINTER_POLL_MS         20
+/* A new window size must hold this long before the X screen follows it. */
+#define RESIZE_SETTLE_MS        250
+#define RESIZE_POLL_MS          50
+/* The smallest X screen the window can be made into, in pixels. */
+#define MIN_SIZE                64
+/* Above this many damaged boxes, redraw their bounding box instead. */
+#define MAX_REDRAW_BOXES        16
+
+/* OS_ReadModeVariable numbers */
+#define VAR_XEIG        4
+#define VAR_YEIG        5
+#define VAR_LINELENGTH  6
+#define VAR_LOG2BPP     9
+#define VAR_XWINDLIMIT  11
+#define VAR_YWINDLIMIT  12
+
+/* VDU variable: the screen memory the VDU drivers draw into */
+#define VDU_SCREENSTART 148
+
+/* The desktop side: one window showing one sprite, for the whole run; and
+   for full screen, a second window covering the desktop. */
+static struct {
+    int window;                 /* the window showing X: normal or full */
+    int normal;                 /* the ordinary window, 0 until made */
+    int full;                   /* the full screen window, 0 until made */
+    int width, height, bpp;     /* the sprite, in pixels */
+    int *area;                  /* sprite area holding the one sprite */
+    int *sprite;                /* the sprite header */
+    CARD8 *pixels;              /* its image: the X framebuffer */
+    int stride;                 /* bytes per row */
+    int xeig, yeig;             /* desktop mode: OS units = pixels << eig */
+    int desk_log2bpp;
+    void *table;                /* ColourTrans table, for desktops <= 8bpp */
+    int vis[4], scroll[2];      /* window's visible area and scroll offsets */
+    char title[64];
+    /* pointer as last reported to X */
+    int pointer_inside, last_x, last_y, last_buttons;
+    /* resizing */
+    ScreenPtr screen;           /* the X screen, once it exists */
+    int max_w, max_h;           /* largest X screen: the work area extent */
+    int pending_w, pending_h;   /* size the window has, X has not, or 0 */
+    long pending_since;         /* when the window last changed size */
+    int resize_queued;          /* a work procedure is due to resize */
+    int scr_w, scr_h;           /* the X screen, in pixels */
+    /* full screen */
+    int fullscreen;             /* wanted: the full window is showing */
+    int on_screen;              /* the framebuffer is screen memory */
+    int switch_queued;          /* a work procedure is due to catch up */
+    int normal_state[9];        /* the normal window, before full screen */
+    RegionRec expose;           /* to repaint, once X can (full screen) */
+    int expose_queued;
+    int pointer_window;         /* the window the pointer last entered */
+    int corner_held;            /* buttons went down in a resize corner:
+                                   not X's, until they're released */
+    int corner_cursor;          /* the resize cursor is showing */
+    int desk_h;                 /* the desktop's height, OS units */
+} rd;
+
+/* Rootless this run: from the options, or -rootless/-norootless. Decided
+   once, at the first card initialisation; a server reset keeps it. */
+Bool riscosRootless;
+int riscosRootlessArg = -1;
+
+static int riscosEvent(int reason, int *block, void *data);
+
+static long
+nowMs(void)
+{
+    int cs = 0;
+
+    _swix(OS_ReadMonotonicTime, _OUT(0), &cs);
+    return (long) cs * 10;
+}
+
+/* Null events are wanted while the pointer is over the window or a button
+   is held (tracking), and while a resize is waiting to settle. */
+static void
+riscosSetNullInterval(void)
+{
+    int ms = 0;
+
+    if (rd.pointer_inside || rd.last_buttons)
+        ms = POINTER_POLL_MS;
+    if (rd.pending_w && (ms == 0 || ms > RESIZE_POLL_MS))
+        ms = RESIZE_POLL_MS;
+    rwl_set_null_interval(ms);
+}
+
+static int
+readModeVar(int var)
+{
+    int value = 0;
+
+    _swix(OS_ReadModeVariable, _INR(0, 1) | _OUT(2), -1, var, &value);
+    return value;
+}
+
+/* (Re)build the colour translation for the current desktop mode. A 16bpp or
+   32bpp desktop plots the sprite as it is; a palette mode needs a table. */
+static void
+riscosReadMode(void)
+{
+    int size = 0;
+
+    rd.xeig = readModeVar(VAR_XEIG);
+    rd.yeig = readModeVar(VAR_YEIG);
+    rd.desk_h = (readModeVar(VAR_YWINDLIMIT) + 1) << rd.yeig;
+    rd.desk_log2bpp = readModeVar(VAR_LOG2BPP);
+    free(rd.table);
+    rd.table = NULL;
+    if (rd.area && rd.desk_log2bpp <= 3) {
+        /* r5 bit 0: r0, r1 give the source as a sprite area and sprite */
+        if (_swix(ColourTrans_SelectTable, _INR(0, 5) | _OUT(4),
+                  rd.area, rd.sprite, -1, -1, 0, 1, &size) == NULL &&
+            size > 0 && (rd.table = malloc(size)) != NULL) {
+            if (_swix(ColourTrans_SelectTable, _INR(0, 5),
+                      rd.area, rd.sprite, -1, -1, rd.table, 1) != NULL) {
+                free(rd.table);
+                rd.table = NULL;
+            }
+        }
+        if (!rd.table)
+            LogMessage(X_WARNING, "RISC OS: no colour table for this "
+                       "%d-colour desktop; colours will be wrong\n",
+                       1 << (1 << rd.desk_log2bpp));
+    }
+}
+
+/* The colour translation for plotting X's pixels on this desktop, or NULL
+   if none is needed. */
+void *
+riscosColourTable(void)
+{
+    return rd.table;
+}
+
+/* A window that shows X: the normal or full screen one, or a frame. */
+static Bool
+riscosOurWindow(int handle)
+{
+    if (handle <= 0)
+        return FALSE;
+    return handle == rd.normal || handle == rd.full ||
+        (riscosRootless && riscosIsFrameWindow(handle));
+}
+
+/* Make the sprite that is the X framebuffer. */
+static Bool
+riscosMakeSprite(int width, int height, int bpp)
+{
+    int stride = ((width * bpp + 31) >> 5) << 2;
+    int image = stride * height;
+    int total = 16 + 44 + image;
+    int type = (bpp == 32) ? 6 : 5;
+    int xdpi = 180 >> rd.xeig, ydpi = 180 >> rd.yeig;
+    int *area, *s;
+
+    if (rd.area && rd.width == width && rd.height == height && rd.bpp == bpp)
+        return TRUE;
+    area = calloc(1, total);
+    if (!area)
+        return FALSE;
+    area[0] = total;            /* sprite area: size */
+    area[1] = 1;                /* number of sprites */
+    area[2] = 16;               /* offset to the first */
+    area[3] = total;            /* offset to free space */
+    s = area + 4;
+    s[0] = 44 + image;          /* offset to the next sprite */
+    strncpy((char *) &s[1], "xscreen", 12);
+    s[4] = stride / 4 - 1;      /* width in words, less one */
+    s[5] = height - 1;          /* height in rows, less one */
+    s[6] = 0;                   /* first bit used */
+    s[7] = (width * bpp - 1) & 31;      /* last bit used in the last word */
+    s[8] = 44;                  /* offset to the image */
+    s[9] = 44;                  /* offset to the mask: none */
+    s[10] = (type << 27) | (ydpi << 14) | (xdpi << 1) | 1;     /* mode word */
+
+    free(rd.area);
+    rd.area = area;
+    rd.sprite = s;
+    rd.pixels = (CARD8 *) s + 44;
+    rd.stride = stride;
+    rd.width = width;
+    rd.height = height;
+    rd.bpp = bpp;
+    riscosReadMode();
+    return TRUE;
+}
+
+static void
+riscosReadWindowState(void)
+{
+    int block[9];
+
+    block[0] = rd.window;
+    if (_swix(Wimp_GetWindowState, _IN(1), block) == NULL) {
+        memcpy(rd.vis, &block[1], sizeof rd.vis);
+        rd.scroll[0] = block[5];
+        rd.scroll[1] = block[6];
+    }
+}
+
+/* Make and open the window, once. */
+static Bool
+riscosMakeWindow(void)
+{
+    int w = rd.width << rd.xeig, h = rd.height << rd.yeig;
+    int screen_w = (readModeVar(VAR_XWINDLIMIT) + 1) << rd.xeig;
+    int screen_h = (readModeVar(VAR_YWINDLIMIT) + 1) << rd.yeig;
+    int vw = w < screen_w - 128 ? w : screen_w - 128;
+    int vh = h < screen_h - 192 ? h : screen_h - 192;
+    int block[23], state[9];
+    _kernel_oserror *e;
+
+    /* The work area, and so the largest the X screen can become: the
+       desktop, or the size asked for if that is bigger. */
+    rd.max_w = rd.width > (screen_w >> rd.xeig) ? rd.width : screen_w >> rd.xeig;
+    rd.max_h = rd.height > (screen_h >> rd.yeig) ? rd.height : screen_h >> rd.yeig;
+
+    snprintf(rd.title, sizeof rd.title, "X server %s (%dx%d)",
+             display ? display : "", rd.width, rd.height);
+    memset(rd.title + strlen(rd.title), 0,
+           sizeof rd.title - strlen(rd.title));
+    memset(block, 0, sizeof block);
+    block[0] = 64;                      /* visible area */
+    block[1] = screen_h - 96 - vh;
+    block[2] = 64 + vw;
+    block[3] = screen_h - 96;
+    block[4] = 0;                       /* scroll offsets */
+    block[5] = 0;
+    block[6] = -1;                      /* open on top */
+    /* new-style flags: back, close, title, toggle, size; moveable. No
+       scroll bars: the X screen follows the window's size. */
+    block[7] = (int) 0xbf000002u;
+    ((char *) block)[32] = 7;           /* title foreground */
+    ((char *) block)[33] = 2;           /* title background */
+    ((char *) block)[34] = 7;           /* work area foreground */
+    ((char *) block)[35] = (char) 0xff; /* work area background: we paint it all */
+    ((char *) block)[36] = 3;           /* scroll bar outer */
+    ((char *) block)[37] = 1;           /* scroll bar inner */
+    ((char *) block)[38] = 12;          /* title background with focus */
+    block[10] = 0;                      /* work area extent */
+    block[11] = -(rd.max_h << rd.yeig);
+    block[12] = rd.max_w << rd.xeig;
+    block[13] = 0;
+    block[14] = 0x13d;                  /* title: indirected text, centred */
+    block[15] = 10 << 12;               /* work area: click/drag buttons */
+    block[16] = 1;                      /* sprite area: the Wimp's */
+    /* minimum width and height, OS units, as two halfwords */
+    block[17] = (MIN_SIZE << rd.xeig) | ((MIN_SIZE << rd.yeig) << 16);
+    block[18] = (int) rd.title;         /* indirected title */
+    block[19] = -1;
+    block[20] = (int) sizeof rd.title;  /* room for the size to change */
+    block[21] = 0;                      /* no icons */
+
+    if ((e = _swix(Wimp_CreateWindow, _IN(1) | _OUT(0), block, &rd.window))) {
+        LogMessage(X_ERROR, "RISC OS: cannot create the window: %s\n",
+                   e->errmess);
+        return FALSE;
+    }
+    rd.normal = rd.window;
+    state[0] = rd.window;
+    _swix(Wimp_GetWindowState, _IN(1), state);
+    state[7] = -1;
+    _swix(Wimp_OpenWindow, _IN(1), state);
+    riscosReadWindowState();
+    return TRUE;
+}
+
+/* Make the full screen window, once: no furniture, covering the desktop,
+   with a transparent background since X draws everything. */
+static Bool
+riscosMakeFullWindow(void)
+{
+    int block[23];
+    _kernel_oserror *e;
+
+    if (rd.full)
+        return TRUE;
+    memset(block, 0, sizeof block);
+    block[6] = -1;
+    block[7] = (int) 0x80000000u;       /* new-style flags, no furniture */
+    ((char *) block)[32] = (char) 0xff; /* no title */
+    ((char *) block)[33] = 2;
+    ((char *) block)[34] = 7;
+    ((char *) block)[35] = (char) 0xff; /* work area background: none */
+    ((char *) block)[36] = 3;
+    ((char *) block)[37] = 1;
+    ((char *) block)[38] = 12;
+    block[11] = -0x4000;                /* work area: bigger than any mode */
+    block[12] = 0x4000;
+    block[14] = 0;                      /* no title */
+    block[15] = 10 << 12;               /* work area: click/drag buttons */
+    block[16] = 1;
+    block[21] = 0;
+    if ((e = _swix(Wimp_CreateWindow, _IN(1) | _OUT(0), block, &rd.full))) {
+        LogMessage(X_ERROR, "RISC OS: cannot create the full screen "
+                   "window: %s\n", e->errmess);
+        rd.full = 0;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* Plot the sprite in answer to a redraw request (or an update). */
+static void
+riscosRedraw(int *block, Bool update)
+{
+    int more = 0;
+    _kernel_oserror *e;
+
+    e = update ? _swix(Wimp_UpdateWindow, _IN(1) | _OUT(0), block, &more)
+               : _swix(Wimp_RedrawWindow, _IN(1) | _OUT(0), block, &more);
+    while (e == NULL && more) {
+        /* Work area origin on screen: its top left. */
+        int ox = block[1] - block[5];
+        int oy = block[4] - block[6];
+
+        int right = ox + (rd.width << rd.xeig);
+        int bottom = oy - (rd.height << rd.yeig);
+
+        _swix(OS_SpriteOp, _INR(0, 7), 52 + 512, rd.area, rd.sprite,
+              ox, bottom, 0, 0, rd.table);
+        /* While a resize settles the window can be bigger than the X
+           screen: paint what the sprite does not cover black. block[7-10]
+           is the graphics window (inclusive). */
+        if (block[9] >= right || block[8] < bottom) {
+            _swix(ColourTrans_SetGCOL, _IN(0) | _INR(3, 4), 0, 0, 0);
+            if (block[9] >= right) {
+                _swix(OS_Plot, _INR(0, 2), 4, right, block[8]);
+                _swix(OS_Plot, _INR(0, 2), 96 + 5, block[9], block[10]);
+            }
+            if (block[8] < bottom) {
+                _swix(OS_Plot, _INR(0, 2), 4, block[7], block[8]);
+                _swix(OS_Plot, _INR(0, 2), 96 + 5, block[9], bottom - 1);
+            }
+        }
+        e = _swix(Wimp_GetRectangle, _IN(1) | _OUT(0), block, &more);
+    }
+}
+
+/* The shadow layer's update: tell the Wimp which parts changed. */
+static void
+riscosShadowUpdate(ScreenPtr pScreen, shadowBufPtr pBuf)
+{
+    RegionPtr damage = shadowDamage(pBuf);
+    int n = RegionNumRects(damage);
+    BoxPtr box = RegionRects(damage);
+
+    if (!rd.normal || n == 0 || rd.on_screen)
+        return;         /* full screen: X drew straight onto the screen */
+    if (n > MAX_REDRAW_BOXES) {
+        box = RegionExtents(damage);
+        n = 1;
+    }
+    while (n--) {
+        _swix(Wimp_ForceRedraw, _INR(0, 4), rd.normal,
+              box->x1 << rd.xeig, -(box->y2 << rd.yeig),
+              box->x2 << rd.xeig, -(box->y1 << rd.yeig));
+        box++;
+    }
+}
+
+static void *
+riscosWindowLinear(ScreenPtr pScreen, CARD32 row, CARD32 offset, int mode,
+                   CARD32 *size, void *closure)
+{
+    *size = rd.stride;
+    return rd.pixels + row * rd.stride;
+}
+
+/* Put the size in the title and redraw the title bar. */
+static void
+riscosSetTitle(void)
+{
+    snprintf(rd.title, sizeof rd.title, "X server %s (%dx%d)",
+             display ? display : "", rd.width, rd.height);
+    if (rd.normal && rd.window == rd.normal)
+        _swix(Wimp_ForceRedraw, _INR(0, 4), -1, rd.vis[0], rd.vis[3],
+              rd.vis[2], rd.vis[3] + (24 << rd.yeig));
+}
+
+/* The desktop's screen memory, as X would draw into it. FALSE if X's depth
+   is not the desktop's. */
+static Bool
+riscosScreenMemory(int bpp, int *w, int *h, int *stride, CARD8 **pixels)
+{
+    int vars[2] = { VDU_SCREENSTART, -1 };
+    int log2bpp = readModeVar(VAR_LOG2BPP);
+
+    if ((bpp == 16 && log2bpp != 4) || (bpp == 32 && log2bpp != 5))
+        return FALSE;
+    if (_swix(OS_ReadVduVariables, _INR(0, 1), vars, vars) != NULL)
+        return FALSE;
+    *pixels = (CARD8 *) vars[0];
+    *stride = readModeVar(VAR_LINELENGTH);
+    *w = readModeVar(VAR_XWINDLIMIT) + 1;
+    *h = readModeVar(VAR_YWINDLIMIT) + 1;
+    return TRUE;
+}
+
+/* Show the cursor X thinks is showing. Disabling the screen takes it away
+   (SetRootClip), and X puts it back only when the pointer next moves into
+   another window; the null first makes mi's pointer code send it again. */
+static void
+riscosRedisplayCursor(ScreenPtr pScreen)
+{
+    DeviceIntPtr dev;
+
+    for (dev = inputInfo.devices; dev; dev = dev->next) {
+        CursorPtr cursor;
+
+        if (!DevHasCursor(dev) || !dev->spriteInfo->sprite)
+            continue;
+        cursor = dev->spriteInfo->sprite->current;
+        if (!cursor)
+            continue;
+        (*pScreen->DisplayCursor) (dev, pScreen, NullCursor);
+        (*pScreen->DisplayCursor) (dev, pScreen, cursor);
+    }
+}
+
+/* Make X's framebuffer width x height pixels at the given address: the
+   screen pixmap moved onto it, the root window resized and repainted
+   (KdEnableScreen), and clients told (RandR). */
+static void
+riscosSetFramebuffer(ScreenPtr pScreen, int width, int height, int stride,
+                     CARD8 *pixels)
+{
+    KdScreenPriv(pScreen);
+    KdScreenInfo *screen = pScreenPriv->screen;
+    PixmapPtr pixmap = pScreen->GetScreenPixmap(pScreen);
+    Bool wasEnabled = pScreenPriv->enabled;
+    /* the first size and physical size, to scale from without drift */
+    static int base_w, base_h, base_mmw, base_mmh;
+
+    if (!base_w) {
+        base_w = screen->width;
+        base_h = screen->height;
+        base_mmw = pScreen->mmWidth;
+        base_mmh = pScreen->mmHeight;
+    }
+    if (wasEnabled)
+        KdDisableScreen(pScreen);
+    shadowRemove(pScreen, pixmap);
+    screen->width = width;
+    screen->height = height;
+    screen->fb.frameBuffer = pixels;
+    screen->fb.byteStride = stride;
+    screen->fb.pixelStride = stride * 8 / screen->fb.bitsPerPixel;
+    /* same resolution: the physical size scales with the pixels */
+    pScreen->mmWidth = (base_mmw * width + base_w / 2) / base_w;
+    pScreen->mmHeight = (base_mmh * height + base_h / 2) / base_h;
+    screen->width_mm = pScreen->mmWidth;
+    screen->height_mm = pScreen->mmHeight;
+    pScreen->width = width;
+    pScreen->height = height;
+    rd.scr_w = width;
+    rd.scr_h = height;
+    (*pScreen->ModifyPixmapHeader) (pixmap, width, height, screen->fb.depth,
+                                    screen->fb.bitsPerPixel, stride, pixels);
+    shadowAdd(pScreen, pixmap, riscosShadowUpdate, riscosWindowLinear, 0, NULL);
+    if (wasEnabled)
+        KdEnableScreen(pScreen);
+#ifdef RANDR
+    RRScreenSizeNotify(pScreen);
+    /* and the output and CRTC, for clients that follow those */
+    RRGetInfo(pScreen, TRUE);
+#endif
+    riscosRedisplayCursor(pScreen);
+}
+
+/* Make the X screen width x height in the window: a new sprite. */
+static Bool
+riscosResizeScreen(ScreenPtr pScreen, int width, int height)
+{
+    KdScreenPriv(pScreen);
+    KdScreenInfo *screen = pScreenPriv->screen;
+
+    if (rd.on_screen || (width == screen->width && height == screen->height))
+        return TRUE;
+    if (!riscosMakeSprite(width, height, screen->fb.bitsPerPixel)) {
+        LogMessage(X_ERROR, "RISC OS: no memory for a %dx%d screen\n",
+                   width, height);
+        return FALSE;
+    }
+    riscosSetFramebuffer(pScreen, width, height, rd.stride, rd.pixels);
+    riscosSetTitle();
+    LogMessage(X_INFO, "RISC OS: screen resized to %dx%d\n", width, height);
+    return TRUE;
+}
+
+/*
+ * Full screen.
+ *
+ * riscosToggleFullscreen() changes the windows at once: going full screen
+ * opens the full window over everything, and the framebuffer moves to
+ * screen memory when that window is first redrawn (the Wimp has finished
+ * with the screen by then). Coming back, the framebuffer moves back to the
+ * sprite first, from a work procedure, and then the windows change.
+ */
+
+int
+riscosIsFullscreen(void)
+{
+    return rd.fullscreen;
+}
+
+static void
+riscosReportError(const char *message)
+{
+    _kernel_oserror err;
+
+    err.errnum = 0;
+    snprintf(err.errmess, sizeof err.errmess, "%s", message);
+    /* OK box, titled with the task's name */
+    _swix(Wimp_ReportError, _INR(0, 2), &err, 1, "X server");
+}
+
+/* The pointer is no longer known to be over the window showing X. */
+static void
+riscosForgetPointer(void)
+{
+    rd.pointer_inside = 0;
+    riscosCursorLeave();
+    if (rd.corner_cursor) {
+        rd.corner_cursor = 0;
+        riscosCursorResize(FALSE);
+    }
+    riscosSetNullInterval();
+}
+
+/* Give the window showing X the input focus. */
+static void
+riscosTakeFocus(void)
+{
+    _swix(Wimp_SetCaretPosition, _INR(0, 5), rd.window, -1, 0, 0,
+          1 << 25, -1);
+}
+
+/* Move X onto the screen memory, or back into the sprite. */
+static void
+riscosSwitchFramebuffer(int on_screen)
+{
+    ScreenPtr pScreen = rd.screen;
+    int w, h, stride;
+    CARD8 *pixels;
+
+    if (!pScreen || on_screen == rd.on_screen)
+        return;
+    if (on_screen) {
+        if (!riscosScreenMemory(rd.bpp, &w, &h, &stride, &pixels))
+            return;
+        rd.on_screen = 1;
+        riscosVCacheStart(pixels, stride * h);
+        riscosSetFramebuffer(pScreen, w, h, stride, pixels);
+        LogMessage(X_INFO, "RISC OS: full screen, %dx%d\n", w, h);
+    }
+    else {
+        /* the sprite is still the size of the window */
+        rd.on_screen = 0;
+        riscosVCacheStop();
+        riscosSetFramebuffer(pScreen, rd.width, rd.height, rd.stride,
+                             rd.pixels);
+        LogMessage(X_INFO, "RISC OS: back in the window, %dx%d\n",
+                   rd.width, rd.height);
+    }
+}
+
+/* Put the windows back as they were before full screen. */
+static void
+riscosLeaveFullWindow(void)
+{
+    int *state = rd.normal_state;
+
+    _swix(Wimp_CloseWindow, _IN(1), &rd.full);
+    riscosForgetPointer();
+    rd.window = rd.normal;
+    state[0] = rd.normal;
+    state[7] = -1;                      /* on top */
+    _swix(Wimp_OpenWindow, _IN(1), state);
+    riscosReadWindowState();
+    riscosTakeFocus();
+    riscosSetTitle();
+}
+
+/* Run from the work queue: bring the framebuffer and windows into line
+   with rd.fullscreen. */
+static Bool
+riscosSwitchWork(ClientPtr client, void *closure)
+{
+    rd.switch_queued = 0;
+    if (rd.fullscreen) {
+        riscosSwitchFramebuffer(1);
+        if (!rd.on_screen) {            /* the desktop changed under us */
+            rd.fullscreen = 0;
+            riscosLeaveFullWindow();
+        }
+    }
+    else {
+        riscosSwitchFramebuffer(0);
+        if (rd.window == rd.full)
+            riscosLeaveFullWindow();
+    }
+    return TRUE;
+}
+
+static void
+riscosQueueSwitch(void)
+{
+    if (rd.switch_queued)
+        return;
+    rd.switch_queued = 1;
+    QueueWorkProc(riscosSwitchWork, NULL, NULL);
+}
+
+int
+riscosToggleFullscreen(void)
+{
+    int w, h, stride, block[9];
+    CARD8 *pixels;
+
+    if (!rd.screen || !rd.normal)
+        return 0;
+    if (rd.fullscreen) {
+        rd.fullscreen = 0;
+        riscosQueueSwitch();
+        return 1;
+    }
+    if (!riscosScreenMemory(rd.bpp, &w, &h, &stride, &pixels)) {
+        riscosReportError(rd.bpp == 16 ?
+            "Full screen needs a desktop with 32 thousand colours, the "
+            "depth X is running at." :
+            "Full screen needs a desktop with 16 million colours, the "
+            "depth X is running at.");
+        return 0;
+    }
+    if (!riscosMakeFullWindow())
+        return 0;
+    /* Remember the normal window, then swap it for the full one. */
+    rd.normal_state[0] = rd.normal;
+    _swix(Wimp_GetWindowState, _IN(1), rd.normal_state);
+    _swix(Wimp_CloseWindow, _IN(1), &rd.normal);
+    riscosForgetPointer();
+    rd.pending_w = rd.pending_h = 0;
+    block[0] = rd.full;
+    block[1] = 0;
+    block[2] = 0;
+    block[3] = w << rd.xeig;
+    block[4] = h << rd.yeig;
+    block[5] = 0;
+    block[6] = 0;
+    block[7] = -1;
+    _swix(Wimp_OpenWindow, _IN(1), block);
+    rd.window = rd.full;
+    rd.fullscreen = 1;
+    riscosReadWindowState();
+    riscosTakeFocus();
+    /* the framebuffer follows when the window is first redrawn */
+    return 0;
+}
+
+/* Select on the icon bar icon. */
+void
+riscosShowWindow(void)
+{
+    int state[9];
+
+    if (rd.fullscreen || !rd.normal)
+        return;
+    state[0] = rd.normal;
+    if (_swix(Wimp_GetWindowState, _IN(1), state) != NULL)
+        return;
+    state[7] = -1;
+    _swix(Wimp_OpenWindow, _IN(1), state);
+    riscosReadWindowState();
+    riscosTakeFocus();
+}
+
+/* Repaint what the Wimp lost of the full screen window: each viewable
+   window's share of it, background and border, with Expose events for its
+   client, as when windows are uncovered. */
+static int
+riscosExposeVisit(WindowPtr pWin, void *data)
+{
+    RegionPtr exposed = data;
+    ScreenPtr pScreen = pWin->drawable.pScreen;
+    RegionRec r;
+
+    if (!pWin->viewable)
+        return WT_DONTWALKCHILDREN;
+    RegionNull(&r);
+    if (wBorderWidth(pWin)) {
+        RegionSubtract(&r, &pWin->borderClip, &pWin->winSize);
+        RegionIntersect(&r, &r, exposed);
+        if (RegionNotEmpty(&r))
+            (*pScreen->PaintWindow) (pWin, &r, PW_BORDER);
+    }
+    RegionIntersect(&r, exposed, &pWin->clipList);
+    if (RegionNotEmpty(&r))
+        (*pScreen->WindowExposures) (pWin, &r);
+    RegionUninit(&r);
+    return WT_WALKCHILDREN;
+}
+
+static Bool
+riscosExposeWork(ClientPtr client, void *closure)
+{
+    rd.expose_queued = 0;
+    if (rd.screen && rd.on_screen && RegionNotEmpty(&rd.expose)) {
+        KdScreenPriv(rd.screen);
+
+        if (pScreenPriv->enabled)
+            TraverseTree(rd.screen->root, riscosExposeVisit, &rd.expose);
+    }
+    RegionEmpty(&rd.expose);
+    return TRUE;
+}
+
+/* A redraw request for the full screen window. Nothing is plotted: X
+   repaints, from a work procedure, what the Wimp says was lost. */
+static int
+riscosRedrawFull(int *block)
+{
+    int more = 0, woken = 0;
+    int ox = rd.vis[0] - rd.scroll[0], oy = rd.vis[3] - rd.scroll[1];
+
+    if (_swix(Wimp_RedrawWindow, _IN(1) | _OUT(0), block, &more) != NULL)
+        return 0;
+    while (more) {
+        if (rd.on_screen) {
+            /* the rectangle, block[7-10], inclusive OS units, as X pixels */
+            BoxRec box;
+            RegionRec r;
+
+            box.x1 = (block[7] - ox) >> rd.xeig;
+            box.x2 = ((block[9] - ox) >> rd.xeig) + 1;
+            box.y1 = (oy - block[10] - 1) >> rd.yeig;
+            box.y2 = ((oy - block[8]) >> rd.yeig) + 1;
+            if (box.x1 < 0) box.x1 = 0;
+            if (box.y1 < 0) box.y1 = 0;
+            if (box.x2 > rd.scr_w) box.x2 = rd.scr_w;
+            if (box.y2 > rd.scr_h) box.y2 = rd.scr_h;
+            if (box.x1 < box.x2 && box.y1 < box.y2) {
+                RegionInit(&r, &box, 1);
+                RegionUnion(&rd.expose, &rd.expose, &r);
+                RegionUninit(&r);
+            }
+        }
+        if (_swix(Wimp_GetRectangle, _IN(1) | _OUT(0), block, &more) != NULL)
+            break;
+    }
+    if (rd.fullscreen && !rd.on_screen) {
+        riscosQueueSwitch();
+        woken = 1;
+    }
+    else if (RegionNotEmpty(&rd.expose) && !rd.expose_queued) {
+        rd.expose_queued = 1;
+        QueueWorkProc(riscosExposeWork, NULL, NULL);
+        woken = 1;
+    }
+    return woken;
+}
+
+/* Run from the server's work queue, outside any request. */
+static Bool
+riscosResizeWork(ClientPtr client, void *closure)
+{
+    rd.resize_queued = 0;
+    if (rd.screen)
+        (void) riscosResizeScreen(rd.screen, (int) (long) closure >> 16,
+                                  (int) (long) closure & 0xffff);
+    return TRUE;
+}
+
+/* The window's size, in X pixels, changed: remember it for later. */
+static void
+riscosWindowSized(void)
+{
+    int w = (rd.vis[2] - rd.vis[0]) >> rd.xeig;
+    int h = (rd.vis[3] - rd.vis[1]) >> rd.yeig;
+
+    if (w < MIN_SIZE) w = MIN_SIZE;
+    if (h < MIN_SIZE) h = MIN_SIZE;
+    if (w > rd.max_w) w = rd.max_w;
+    if (h > rd.max_h) h = rd.max_h;
+    if (w == rd.width && h == rd.height) {
+        rd.pending_w = rd.pending_h = 0;
+    }
+    else if (w != rd.pending_w || h != rd.pending_h) {
+        rd.pending_w = w;
+        rd.pending_h = h;
+        rd.pending_since = nowMs();
+    }
+    riscosSetNullInterval();
+}
+
+/* Once a new size has settled, queue the resize. Returns non-zero if it
+   queued one, to wake the server. */
+static int
+riscosCheckResize(void)
+{
+    if (!rd.pending_w || rd.resize_queued || !rd.screen || rd.fullscreen)
+        return 0;
+    if (nowMs() - rd.pending_since < RESIZE_SETTLE_MS)
+        return 0;
+    rd.resize_queued = 1;
+    QueueWorkProc(riscosResizeWork, NULL,
+                  (void *) (long) ((rd.pending_w << 16) | rd.pending_h));
+    rd.pending_w = rd.pending_h = 0;
+    riscosSetNullInterval();
+    return 1;
+}
+
+/* Read the pointer and queue an X event if it moved or a button changed. */
+int
+riscosPollPointer(void)
+{
+    int block[5], x, y, buttons;
+    unsigned long flags = 0;
+
+    if (!riscosPointer || (!rd.window && !riscosRootless))
+        return 0;
+    if (_swix(Wimp_GetPointerInfo, _IN(1), block) != NULL)
+        return 0;
+    /* Over another window: report nothing, unless a button is held down,
+       when X expects to see the drag go on (it is clamped to the screen). */
+    if (riscosRootless) {
+        /* A press in a window's resize corner is the Wimp's (a resize
+           drag, see Mouse_Click), so X doesn't see it, nor the pointer,
+           until the buttons are let go. */
+        int corner;
+
+        if (rd.corner_held) {
+            if ((block[2] & 7) == 0)
+                rd.corner_held = 0;
+            else
+                return 0;
+        }
+        /* The resize cursor while over a corner, or resizing */
+        corner = rd.last_buttons == 0 &&
+            riscosFrameCorner(block[3], block[0], block[1]);
+        if (corner != rd.corner_cursor) {
+            rd.corner_cursor = corner;
+            riscosCursorResize(corner);
+        }
+        if (corner && (block[2] & 7)) {
+            rd.corner_held = 1;
+            return 0;
+        }
+        if (!riscosIsFrameWindow(block[3]) && rd.last_buttons == 0)
+            return 0;
+        /* X's screen is the desktop */
+        x = block[0] >> rd.xeig;
+        y = (rd.desk_h - 1 - block[1]) >> rd.yeig;
+    }
+    else {
+        if (block[3] != rd.window && rd.last_buttons == 0)
+            return 0;
+        x = (block[0] - (rd.vis[0] - rd.scroll[0])) >> rd.xeig;
+        y = ((rd.vis[3] - rd.scroll[1]) - block[1]) >> rd.yeig;
+    }
+    if (x < 0) x = 0;
+    if (y < 0) y = 0;
+    if (x >= rd.scr_w) x = rd.scr_w - 1;
+    if (y >= rd.scr_h) y = rd.scr_h - 1;
+    /* RISC OS: 4 Select, 2 Menu, 1 Adjust. X: 1, 2, 3. */
+    buttons = block[2] & 7;
+    if (x == rd.last_x && y == rd.last_y && buttons == rd.last_buttons)
+        return 0;
+    if (buttons & 4) flags |= KD_BUTTON_1;
+    if (buttons & 2) flags |= KD_BUTTON_2;
+    if (buttons & 1) flags |= KD_BUTTON_3;
+    rd.last_x = x;
+    rd.last_y = y;
+    if (buttons != rd.last_buttons) {
+        rd.last_buttons = buttons;
+        riscosSetNullInterval();        /* a drag may have ended outside */
+    }
+    KdEnqueuePointerEvent(riscosPointer, flags, x, y, 0);
+    return 1;
+}
+
+/* Wimp events from rwl. Returns non-zero when X has input to process. */
+static int
+riscosEvent(int reason, int *block, void *data)
+{
+    switch (reason) {
+    case 0:                             /* null: pointer tracking, resizing */
+    {
+        int woken = riscosCheckResize();
+
+        if (rd.pointer_inside || rd.last_buttons)
+            woken |= riscosPollPointer();
+        return woken;
+    }
+    case Redraw_Window_Request:
+        /* An error box, say, puts the Wimp's pointer back without the
+           pointer leaving the window: X's comes back with the redraw. */
+        if (rd.pointer_inside && block[0] == rd.pointer_window)
+            riscosCursorEnter(rd.xeig, rd.yeig);
+        if (riscosRootless) {
+            int r = riscosRootlessEvent(reason, block);
+
+            if (r >= 0)
+                return r;
+        }
+        if (block[0] == rd.normal)
+            riscosRedraw(block, FALSE);
+        else if (block[0] == rd.full)
+            return riscosRedrawFull(block);
+        return 0;
+    case Open_Window_Request:
+        if (riscosRootless) {
+            int r = riscosRootlessEvent(reason, block);
+
+            if (r >= 0)
+                return r;
+        }
+        /* Only the window showing X: after a mode change the Wimp asks
+           again for windows that may have been closed since. */
+        if (block[0] != rd.window)
+            return 0;
+        if (block[0] == rd.full) {
+            _swix(Wimp_OpenWindow, _IN(1), block);
+            riscosReadWindowState();
+        }
+        else {
+            /* RISC OS 3.7 draws a vertical scroll bar alongside the size
+               icon; keep it inert, since the X screen fills the window. */
+            block[5] = 0;
+            block[6] = 0;
+            _swix(Wimp_OpenWindow, _IN(1), block);
+            riscosReadWindowState();
+            riscosWindowSized();
+        }
+        return 0;
+    case Close_Window_Request:
+        if (riscosRootless) {
+            int r = riscosRootlessEvent(reason, block);
+
+            if (r >= 0)
+                return r;
+        }
+        /* X carries on; Select on the icon bar icon opens it again. */
+        if (block[0] == rd.normal) {
+            _swix(Wimp_CloseWindow, _IN(1), block);
+            if (rd.window == rd.normal)
+                riscosForgetPointer();
+        }
+        return 0;
+    case Pointer_Entering_Window:
+        if (!(riscosRootless ? riscosIsFrameWindow(block[0])
+                             : block[0] == rd.window))
+            return 0;
+        rd.pointer_inside = 1;
+        rd.pointer_window = block[0];
+        riscosCursorEnter(rd.xeig, rd.yeig);
+        riscosSetNullInterval();
+        return riscosPollPointer();
+    case Pointer_Leaving_Window:
+        if (!rd.pointer_inside || block[0] != rd.pointer_window)
+            return 0;
+        rd.pointer_inside = 0;
+        riscosCursorLeave();
+        if (rd.corner_cursor) {
+            rd.corner_cursor = 0;
+            riscosCursorResize(FALSE);
+        }
+        riscosSetNullInterval();        /* still polled while a button is held */
+        return riscosPollPointer();
+    case Mouse_Click:
+        if (riscosRootless && riscosIsFrameWindow(block[3])) {
+            /* The caret, so the keys, and to the front */
+            _swix(Wimp_SetCaretPosition, _INR(0, 5), block[3], -1, 0, 0,
+                  1 << 25, -1);
+            riscosFrameClick(block[3]);
+            /* A Select or Adjust drag (64, 16) from the resize corner */
+            if ((block[2] & (64 | 16)) &&
+                riscosFrameCorner(block[3], block[0], block[1])) {
+                rd.corner_held = 1;
+                riscosFrameResizeDrag(block[3]);
+                return 1;
+            }
+            return riscosPollPointer() | 1;
+        }
+        if (block[3] == rd.window && rd.window) {
+            /* Take the input focus, with no visible caret. */
+            riscosTakeFocus();
+            return riscosPollPointer();
+        }
+        return riscosIconbarClick(block);
+    case Menu_Selection:
+        return riscosMenuSelection(block);
+    case Key_Pressed:
+        /* With the focus, keys reach X through KeyV (rwl), as presses and
+           releases of physical keys; the Wimp's translated copy is not
+           wanted. Anything else is passed on. */
+        if (!riscosOurWindow(block[0]))
+            _swix(Wimp_ProcessKey, _IN(0), block[6]);
+        return 0;
+    case Gain_Caret:
+        if (riscosOurWindow(block[0])) {
+            rwl_key_capture(1);
+            if (riscosRootless) {
+                riscosFrameFocus(block[0]);
+                return 1;
+            }
+        }
+        return 0;
+    case Lose_Caret:
+        if (!riscosOurWindow(block[0]))
+            return 0;
+        rwl_key_capture(0);
+        return riscosKeysReleaseAll();
+    case RWL_REASON_KEYS:
+        return riscosKeyEvents();
+    case User_Message:
+    case User_Message_Recorded:
+        if (block[4] == Message_ModeChange) {
+            riscosReadMode();
+            if (riscosRootless)
+                riscosRootlessModeChange();
+            if (rd.fullscreen) {
+                /* The screen memory X draws into may have moved: back to
+                   the window now, before X draws again. */
+                rd.fullscreen = 0;
+                riscosSwitchFramebuffer(0);
+                riscosLeaveFullWindow();
+            }
+            if (rd.normal) {
+                riscosReadWindowState();
+                _swix(Wimp_ForceRedraw, _INR(0, 4), rd.normal,
+                      0, -(rd.height << rd.yeig), rd.width << rd.xeig, 0);
+            }
+        }
+        return 0;
+    default:
+        return 0;
+    }
+}
+
+/* kdrive card and screen functions */
+
+Bool
+riscosCardInit(KdCardInfo * card)
+{
+    static Bool mode_decided;
+    const char *why = "";
+    char name[48];
+
+    snprintf(name, sizeof name, "X server %s", display ? display : "");
+    if (rwl_init(name, &why) != 0) {
+        ErrorF("Xriscos must run as a Wimp task in the desktop: %s\n", why);
+        return FALSE;
+    }
+    rwl_set_handler(riscosEvent, NULL);
+    rwl_set_idle_hook(riscosVCacheIdle);
+    if (!mode_decided) {
+        riscosOptionsLoad();
+        riscosRootless = riscosRootlessArg >= 0 ? riscosRootlessArg
+                                                : riscosOptRootless;
+        mode_decided = TRUE;
+        if (riscosRootless)
+            LogMessage(X_INFO, "RISC OS: rootless\n");
+    }
+    /* Composite and the rootless layer can't share windows' pixmaps: a
+       redirected window (as Composite makes of any ARGB window, such as
+       Firefox's popups) gets its pixmap's screen_x/y set while that pixmap
+       is the layer's scratch header, which later draws another frame at
+       that offset, far outside its sprite. XQuartz and XWin's multiwindow
+       mode go without Composite too. InitExtensions comes after this. */
+    if (riscosRootless)
+        noCompositeExtension = TRUE;
+    riscosIconbarInit();
+    card->driver = &rd;
+    return TRUE;
+}
+
+/* A frame's window has closed or gone (rootless.c). */
+void
+riscosFrameGone(int handle)
+{
+    if (rd.pointer_inside && rd.pointer_window == handle)
+        riscosForgetPointer();
+}
+
+/* The icon bar menu's Rootless: the option for the next start. */
+void
+riscosToggleRootless(void)
+{
+    riscosOptRootless = !riscosOptRootless;
+    if (!riscosOptionsSave())
+        riscosReportError("The option could not be saved.");
+    else if (riscosOptRootless != riscosRootless)
+        riscosReportError(riscosOptRootless ?
+            "The X server will be rootless, each X window a RISC OS "
+            "window, from the next time it starts." :
+            "The X server will show its screen in one window again from "
+            "the next time it starts.");
+}
+
+Bool
+riscosScreenInit(KdScreenInfo * screen)
+{
+    RiscosScrPriv *scrpriv;
+
+    scrpriv = calloc(1, sizeof(RiscosScrPriv));
+    if (!scrpriv)
+        return FALSE;
+    screen->driver = scrpriv;
+    scrpriv->randr = RR_Rotate_0;
+
+    if (!screen->width || !screen->height) {
+        screen->width = 640;
+        screen->height = 480;
+    }
+    screen->rate = 60;
+    screen->fb.visuals = (1 << TrueColor);
+    /* RISC OS pixel layouts: red in the low bits. */
+    if (screen->fb.depth > 16) {
+        screen->fb.depth = 24;
+        screen->fb.bitsPerPixel = 32;
+        screen->fb.redMask = 0x0000ff;
+        screen->fb.greenMask = 0x00ff00;
+        screen->fb.blueMask = 0xff0000;
+    }
+    else {
+        screen->fb.depth = 15;
+        screen->fb.bitsPerPixel = 16;
+        screen->fb.redMask = 0x001f;
+        screen->fb.greenMask = 0x03e0;
+        screen->fb.blueMask = 0x7c00;
+    }
+
+    riscosReadMode();
+    screen->fb.shadow = FALSE;          /* fb draws straight in */
+    if (riscosRootless) {
+        /* The X screen is the desktop, and its root window is never
+           shown: the rootless layer replaces the screen pixmap with one
+           row (RootlessUpdateScreenPixmap) before anything draws on it.
+           A one-row sprite stands in until then, and gives the colour
+           table for plotting the frames' sprites, which are its format. */
+        screen->width = readModeVar(VAR_XWINDLIMIT) + 1;
+        screen->height = readModeVar(VAR_YWINDLIMIT) + 1;
+        if (!riscosMakeSprite(screen->width, 1, screen->fb.bitsPerPixel)) {
+            free(scrpriv);
+            screen->driver = NULL;
+            return FALSE;
+        }
+        screen->fb.frameBuffer = rd.pixels;
+        screen->fb.byteStride = rd.stride;
+        screen->fb.pixelStride = rd.stride * 8 / screen->fb.bitsPerPixel;
+        rd.scr_w = screen->width;
+        rd.scr_h = screen->height;
+        return TRUE;
+    }
+    if (rd.on_screen) {
+        /* A server reset while full screen: carry on drawing on it. */
+        int w, h, stride;
+        CARD8 *pixels;
+
+        if (riscosScreenMemory(screen->fb.bitsPerPixel, &w, &h, &stride,
+                               &pixels)) {
+            screen->width = w;
+            screen->height = h;
+            screen->fb.frameBuffer = pixels;
+            screen->fb.byteStride = stride;
+            screen->fb.pixelStride = stride * 8 / screen->fb.bitsPerPixel;
+            rd.scr_w = w;
+            rd.scr_h = h;
+            return TRUE;
+        }
+        rd.on_screen = 0;
+        rd.fullscreen = 0;
+        riscosVCacheStop();
+        riscosLeaveFullWindow();
+        screen->width = rd.width;
+        screen->height = rd.height;
+    }
+    if (!riscosMakeSprite(screen->width, screen->height,
+                          screen->fb.bitsPerPixel)) {
+        free(scrpriv);
+        screen->driver = NULL;
+        return FALSE;
+    }
+    if (!rd.normal && !riscosMakeWindow()) {
+        free(scrpriv);
+        screen->driver = NULL;
+        return FALSE;
+    }
+    screen->fb.frameBuffer = rd.pixels;
+    screen->fb.byteStride = rd.stride;
+    screen->fb.pixelStride = rd.stride * 8 / screen->fb.bitsPerPixel;
+    rd.scr_w = screen->width;
+    rd.scr_h = screen->height;
+    return TRUE;
+}
