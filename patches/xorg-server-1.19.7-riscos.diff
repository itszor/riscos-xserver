+/*
+ * Xriscos pointer: the RISC OS mouse over the X window.
+ *
+ * There is no device to read. riscos.c polls the Wimp for the pointer's
+ * position and buttons while it is over the window, and queues events on the
+ * device registered here.
+ */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include "riscos.h"
+
+KdPointerInfo *riscosPointer;
+
+static Status
+RiscosMouseInit(KdPointerInfo * pi)
+{
+    pi->nButtons = 3;
+    pi->name = strdup("RISC OS mouse");
+    return Success;
+}
+
+static Status
+RiscosMouseEnable(KdPointerInfo * pi)
+{
+    riscosPointer = pi;
+    return Success;
+}
+
+static void
+RiscosMouseDisable(KdPointerInfo * pi)
+{
+    riscosPointer = NULL;
+}
+
+static void
+RiscosMouseFini(KdPointerInfo * pi)
+{
+}
+
+KdPointerDriver RiscosPointerDriver = {
+    "riscos",
+    RiscosMouseInit,
+    RiscosMouseEnable,
+    RiscosMouseDisable,
+    RiscosMouseFini,
+};
--- a/hw/kdrive/riscos/kbd.c	1970-01-01 01:00:00.000000000 +0100
+++ b/hw/kdrive/riscos/kbd.c	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,134 @@
+/*
+ * Xriscos keyboard.
+ *
+ * Keys come from a KeyV handler in rwl's RMA block: every key going down or
+ * up, by RISC OS low-level key number, including modifiers on their own. They
+ * are queued only while the X window has the input focus. Each is mapped to
+ * its evdev (Linux) key code, which is what the precompiled keymaps use, so
+ * the X keycode is that plus 8 (minScanCode 0, KD_MIN_KEYCODE 8).
+ */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include <rwl.h>
+#include "riscos.h"
+
+KdKeyboardInfo *riscosKeyboard;
+Bool riscosKeyLog;
+
+/*
+ * RISC OS low-level key number -> evdev key code (0: none). The layout is by
+ * position: RISC OS reports which key, and XKB decides what it types, so a
+ * UK keyboard wants the "gb" keymap (-xkb-layout gb).
+ */
+static const unsigned char riscos_to_evdev[128] = {
+    /* 0x00 */  1,  59,  60,  61,  62,  63,  64,  65,   /* Esc, F1-F7 */
+    /* 0x08 */ 66,  67,  68,  87,  88,  99,  70, 119,   /* F8-F12, Print, Scroll, Break */
+    /* 0x10 */ 41,   2,   3,   4,   5,   6,   7,   8,   /* ` 1-7 */
+    /* 0x18 */  9,  10,  11,  12,  13,   0,  14, 110,   /* 8 9 0 - = (pound) Backspace Insert */
+    /* 0x20 */102, 104,  69,  98,  55,   0,  15,  16,   /* Home PgUp NumLock KP/ KP* (KP#) Tab Q */
+    /* 0x28 */ 17,  18,  19,  20,  21,  22,  23,  24,   /* W E R T Y U I O */
+    /* 0x30 */ 25,  26,  27,  43, 111, 107, 109,  71,   /* P [ ] \/# Delete End PgDn KP7 */
+    /* 0x38 */ 72,  73,  74,  29,  30,  31,  32,  33,   /* KP8 KP9 KP- LCtrl A S D F */
+    /* 0x40 */ 34,  35,  36,  37,  38,  39,  40,  28,   /* G H J K L ; ' Return */
+    /* 0x48 */ 75,  76,  77,  78,  42,  86,  44,  45,   /* KP4 KP5 KP6 KP+ LShift \(ISO) Z X */
+    /* 0x50 */ 46,  47,  48,  49,  50,  51,  52,  53,   /* C V B N M , . / */
+    /* 0x58 */ 54, 103,  79,  80,  81,  58,  56,  57,   /* RShift Up KP1 KP2 KP3 Caps LAlt Space */
+    /* 0x60 */100,  97, 105, 108, 106,  82,  83,  96,   /* RAlt RCtrl Left Down Right KP0 KP. KPEnter */
+    /* 0x68 */125, 126, 127,   0,   0,   0,   0,   0,   /* LWin RWin Menu */
+    /* 0x70 */  0,   0,   0,   0,   0,   0,   0,   0,   /* mouse buttons: not keys */
+    /* 0x78 */  0,   0,   0,   0,   0,   0,   0,   0,
+};
+
+/* Keys X has been told are down, by evdev code, so they can be released if
+   the window loses the focus while they are held. */
+static unsigned char key_down[256];
+
+/* Take the keys rwl has queued and pass them to X. Returns non-zero if any
+   were queued for X. */
+int
+riscosKeyEvents(void)
+{
+    int key, pressed, queued = 0;
+
+    while (rwl_key_next(&key, &pressed)) {
+        int code = key < 128 ? riscos_to_evdev[key] : 0;
+
+        if (riscosKeyLog)
+            ErrorF("Xriscos: key &%02X %s -> evdev %d\n",
+                   key, pressed ? "down" : "up", code);
+        if (code == 0 || !riscosKeyboard)
+            continue;
+        if (!pressed && !key_down[code])
+            continue;           /* pressed before we had the focus */
+        key_down[code] = pressed;
+        KdEnqueueKeyboardEvent(riscosKeyboard, code, !pressed);
+        queued = 1;
+    }
+    return queued;
+}
+
+/* The window lost the focus: let go of everything X thinks is held. */
+int
+riscosKeysReleaseAll(void)
+{
+    int code, queued = 0;
+
+    (void) riscosKeyEvents();
+    for (code = 0; code < 256; code++)
+        if (key_down[code]) {
+            key_down[code] = 0;
+            if (riscosKeyboard)
+                KdEnqueueKeyboardEvent(riscosKeyboard, code, TRUE);
+            queued = 1;
+        }
+    return queued;
+}
+
+static Status
+RiscosKeyboardInit(KdKeyboardInfo * ki)
+{
+    ki->minScanCode = 0;
+    ki->maxScanCode = 247;
+    ki->name = strdup("RISC OS keyboard");
+    return Success;
+}
+
+static Status
+RiscosKeyboardEnable(KdKeyboardInfo * ki)
+{
+    riscosKeyboard = ki;
+    return Success;
+}
+
+static void
+RiscosKeyboardDisable(KdKeyboardInfo * ki)
+{
+    riscosKeyboard = NULL;
+}
+
+static void
+RiscosKeyboardFini(KdKeyboardInfo * ki)
+{
+}
+
+static void
+RiscosKeyboardLeds(KdKeyboardInfo * ki, int leds)
+{
+}
+
+static void
+RiscosKeyboardBell(KdKeyboardInfo * ki, int volume, int frequency, int duration)
+{
+}
+
+KdKeyboardDriver RiscosKeyboardDriver = {
+    "riscos",
+    RiscosKeyboardInit,
+    RiscosKeyboardEnable,
+    RiscosKeyboardLeds,
+    RiscosKeyboardBell,
+    RiscosKeyboardDisable,
+    RiscosKeyboardFini,
+    NULL,
+};
