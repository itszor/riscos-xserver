+
+void
+ddxUseMsg(void)
+{
+    KdUseMsg();
+    ErrorF("\nXriscos options:\n");
+    ErrorF("-keylog                report each RISC OS key event and its mapping\n");
+    ErrorF("-novcache              full screen: leave screen memory uncached\n");
+    ErrorF("-rootless              each X window a RISC OS window, whatever the\n"
+           "                       option saved from the icon bar menu says\n");
+    ErrorF("-norootless            the X screen in one window, likewise\n");
+}
+
+int
+ddxProcessArgument(int argc, char **argv, int i)
+{
+    if (!strcmp(argv[i], "-keylog")) {
+        riscosKeyLog = TRUE;
+        return 1;
+    }
+    if (!strcmp(argv[i], "-rootless")) {
+        riscosRootlessArg = 1;
+        return 1;
+    }
+    if (!strcmp(argv[i], "-norootless")) {
+        riscosRootlessArg = 0;
+        return 1;
+    }
+    if (!strcmp(argv[i], "-novcache")) {
+        riscosVCacheEnabled = FALSE;
+        return 1;
+    }
+    return KdProcessArgument(argc, argv, i);
+}
+
+void
+OsVendorInit(void)
+{
+    KdOsInit(&RiscosOsFuncs);
+}
+
+KdCardFuncs riscosFuncs = {
+    riscosCardInit,             /* cardinit */
