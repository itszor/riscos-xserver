+/*
+ * A frame's pixmap, once SetPixmapBaseToScreen has moved its base back to
+ * the screen's origin, is indexed by screen coordinates, so its size must
+ * reach the frame's far corner in those: dix bounds GetImage on a window by
+ * its pixmap's size, and refused a frame away from the top left while it
+ * was being drawn on.
+ */
+#define SetPixmapSizeToScreen(pix, _x, _y, _w, _h) {                        \
+    PixmapPtr   _pPx = (PixmapPtr) (pix);                                   \
+    _pPx->drawable.width = (_w) + ((_x) > 0 ? (_x) : 0);                    \
+    _pPx->drawable.height = (_h) + ((_y) > 0 ? (_y) : 0);                   \
+}
