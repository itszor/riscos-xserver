+/*
+ * Xriscos: options kept between runs.
+ *
+ * A text file of "Name value" lines, read from Choices:Xriscos.Options (or,
+ * without a Choices$Write, <Xriscos$Dir>.Options), and written back when an
+ * option is changed from the icon bar menu. Only Rootless so far.
+ */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <kernel.h>
+#include <swis.h>
+#include "riscos.h"
+
+#define OPTIONS_READ_CHOICES    "Choices:Xriscos.Options"
+#define OPTIONS_WRITE_DIR       "<Choices$Write>.Xriscos"
+#define OPTIONS_WRITE_CHOICES   "<Choices$Write>.Xriscos.Options"
+#define OPTIONS_LOCAL           "<Xriscos$Dir>.Options"
+#define FILETYPE_TEXT           0xFFF
+#define OPTIONS_MAX             4096
+
+Bool riscosOptRootless;         /* as saved: for the next start */
+
+/* Read a whole file; NULL if it isn't there. */
+static char *
+readFile(const char *name, int *len)
+{
+    int type = 0, size = 0;
+    char *buf;
+
+    if (_swix(OS_File, _INR(0, 1) | _OUT(0) | _OUT(4), 17, name, &type,
+              &size) != NULL || type != 1 || size > OPTIONS_MAX)
+        return NULL;
+    buf = malloc(size + 1);
+    if (!buf)
+        return NULL;
+    if (_swix(OS_File, _INR(0, 3), 16, name, buf, 0) != NULL) {
+        free(buf);
+        return NULL;
+    }
+    buf[size] = '\0';
+    *len = size;
+    return buf;
+}
+
+static Bool
+isYes(const char *v)
+{
+    return !strncmp(v, "yes", 3) || !strncmp(v, "on", 2) || *v == '1';
+}
+
+void
+riscosOptionsLoad(void)
+{
+    int len = 0;
+    char *buf = readFile(OPTIONS_READ_CHOICES, &len), *line, *next;
+
+    if (!buf)
+        buf = readFile(OPTIONS_LOCAL, &len);
+    if (!buf)
+        return;
+    for (line = buf; line && *line; line = next) {
+        char *value;
+
+        next = strchr(line, '\n');
+        if (next)
+            *next++ = '\0';
+        while (isspace((unsigned char) *line))
+            line++;
+        if (*line == '#' || *line == '\0')
+            continue;
+        value = line;
+        while (*value && !isspace((unsigned char) *value))
+            value++;
+        if (*value)
+            *value++ = '\0';
+        while (isspace((unsigned char) *value))
+            value++;
+        if (!strcasecmp(line, "Rootless"))
+            riscosOptRootless = isYes(value);
+    }
+    free(buf);
+}
+
+static _kernel_oserror *
+saveFile(const char *name, const char *text)
+{
+    return _swix(OS_File, _INR(0, 2) | _INR(4, 5), 10, name, FILETYPE_TEXT,
+                 text, text + strlen(text));
+}
+
+/* Returns FALSE, with a message logged, if they couldn't be saved. */
+Bool
+riscosOptionsSave(void)
+{
+    char text[256];
+    _kernel_oserror *e;
+
+    snprintf(text, sizeof text,
+             "# Xriscos options, written by its icon bar menu\n"
+             "Rootless %s\n", riscosOptRootless ? "yes" : "no");
+    /* Choices, as RISC OS 3.5 and later keep them; else beside Xriscos */
+    (void) _swix(OS_File, _INR(0, 1) | _IN(4), 8, OPTIONS_WRITE_DIR, 0);
+    e = saveFile(OPTIONS_WRITE_CHOICES, text);
+    if (e)
+        e = saveFile(OPTIONS_LOCAL, text);
+    if (e) {
+        LogMessage(X_WARNING, "RISC OS: cannot save the options: %s\n",
+                   e->errmess);
+        return FALSE;
+    }
+    return TRUE;
+}
