--- a/hw/kdrive/riscos/cursor.c	1970-01-01 01:00:00.000000000 +0100
+++ b/hw/kdrive/riscos/cursor.c	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,289 @@
+/*
+ * Xriscos cursor: the X cursor is the RISC OS pointer.
+ *
+ * Without this, kdrive draws X's cursor into the framebuffer, and it shows in
+ * the window under the RISC OS pointer. Instead each X cursor is turned into
+ * a 2bpp sprite, and while the pointer is over the window the current one is
+ * made the RISC OS pointer shape (OS_SpriteOp 36, shape 2, with its palette).
+ * Leaving the window, or the server exiting, puts the Wimp's own pointer back.
+ *
+ * The RISC OS pointer has a transparent colour and three others, and is at
+ * most 32 pixels wide. A core X cursor (two colours and a mask) fits exactly:
+ * colour 1 is its background, 2 its foreground. A full-colour (ARGB) cursor
+ * is reduced: alpha below half is transparent, the rest white, black or grey
+ * by brightness. Anything beyond 32x32 is clipped, keeping the hot spot.
+ */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include <stdlib.h>
+#include <string.h>
+#include <kernel.h>
+#include <swis.h>
+#include "riscos.h"
+#include "cursorstr.h"
+#include "mipointer.h"
+#include "servermd.h"
+
+#define PTR_SHAPE       2       /* the shape applications use; 1 is the Wimp's */
+#define PTR_MAX         32      /* pixels, either way */
+#define SPRITE_PALETTE  (4 * 8) /* 2bpp: four entries of two words */
+
+static DevPrivateKeyRec riscosCursorKey;
+
+/* A cursor as RISC OS wants it: a sprite area with one 2bpp sprite. */
+typedef struct {
+    int *area;
+    int hotx, hoty;
+} RiscosCursor;
+
+static RiscosCursor blank;              /* for "no cursor" */
+static RiscosCursor *current;           /* what X last asked for */
+static int showing;                     /* our shape is the pointer now */
+static int xeig = 1, yeig = 1;
+
+static RiscosCursor *
+cursorPriv(CursorPtr cursor)
+{
+    return dixGetPrivateAddr(&cursor->devPrivates, &riscosCursorKey);
+}
+
+static unsigned
+paletteWord(unsigned short r, unsigned short g, unsigned short b)
+{
+    /* RISC OS palette entry: &BBGGRR00 */
+    return ((unsigned) (b >> 8) << 24) | ((unsigned) (g >> 8) << 16) |
+        ((unsigned) (r >> 8) << 8);
+}
+
+/* Make a w x h 2bpp sprite with the given colours 1-3; pixels are filled
+   in by the caller through *pixels (one byte per four pixels, leftmost in
+   the low bits) with *stride bytes per row. */
+static int *
+makeSprite(int w, int h, const unsigned colours[3], unsigned char **pixels,
+           int *stride)
+{
+    int row = ((w * 2 + 31) >> 5) << 2;
+    int image = 44 + SPRITE_PALETTE;
+    int total = 16 + image + row * h;
+    int *area = calloc(1, total), *s, i;
+
+    if (!area)
+        return NULL;
+    area[0] = total;
+    area[1] = 1;
+    area[2] = 16;
+    area[3] = total;
+    s = area + 4;
+    s[0] = image + row * h;
+    strncpy((char *) &s[1], "xcursor", 12);
+    s[4] = row / 4 - 1;
+    s[5] = h - 1;
+    s[6] = 0;
+    s[7] = (w * 2 - 1) & 31;
+    s[8] = image;
+    s[9] = image;                       /* no mask: colour 0 is transparent */
+    /* 2bpp, at the desktop's resolution so it is not scaled */
+    s[10] = (2 << 27) | ((180 >> yeig) << 14) | ((180 >> xeig) << 1) | 1;
+    for (i = 0; i < 3; i++)             /* palette entries 1-3, both words */
+        s[11 + 2 * (i + 1)] = s[11 + 2 * (i + 1) + 1] = (int) colours[i];
+    *pixels = (unsigned char *) s + image;
+    *stride = row;
+    return area;
+}
+
+static inline void
+setPixel(unsigned char *pixels, int stride, int x, int y, int colour)
+{
+    pixels[y * stride + (x >> 2)] |= colour << ((x & 3) * 2);
+}
+
+static inline int
+bitAt(const unsigned char *bits, int stride, int x, int y)
+{
+#if BITMAP_BIT_ORDER == LSBFirst
+    return (bits[y * stride + (x >> 3)] >> (x & 7)) & 1;
+#else
+    return (bits[y * stride + (x >> 3)] >> (7 - (x & 7))) & 1;
+#endif
+}
+
+/* The window onto the X cursor that fits a RISC OS pointer: up to 32x32,
+   moved if need be to keep the hot spot inside. */
+static void
+clipWindow(int width, int height, int xhot, int yhot, int *x0, int *y0,
+           int *w, int *h)
+{
+    *w = width < PTR_MAX ? width : PTR_MAX;
+    *h = height < PTR_MAX ? height : PTR_MAX;
+    *x0 = 0;
+    *y0 = 0;
+    if (xhot >= *w)
+        *x0 = xhot - *w + 1;
+    if (yhot >= *h)
+        *y0 = yhot - *h + 1;
+}
+
+static Bool
+riscosRealizeCursor(DeviceIntPtr dev, ScreenPtr screen, CursorPtr cursor)
+{
+    RiscosCursor *rc = cursorPriv(cursor);
+    CursorBitsPtr bits = cursor->bits;
+    unsigned colours[3];
+    unsigned char *pixels;
+    int stride, x, y, x0, y0, w, h;
+
+    free(rc->area);
+    clipWindow(bits->width, bits->height, bits->xhot, bits->yhot,
+               &x0, &y0, &w, &h);
+    rc->hotx = bits->xhot - x0;
+    rc->hoty = bits->yhot - y0;
+
+    if (bits->argb) {
+        colours[0] = paletteWord(0xffff, 0xffff, 0xffff);
+        colours[1] = paletteWord(0, 0, 0);
+        colours[2] = paletteWord(0x8000, 0x8000, 0x8000);
+        rc->area = makeSprite(w, h, colours, &pixels, &stride);
+        if (!rc->area)
+            return FALSE;
+        for (y = 0; y < h; y++)
+            for (x = 0; x < w; x++) {
+                CARD32 p = bits->argb[(y + y0) * bits->width + (x + x0)];
+                unsigned a = p >> 24, lum;
+
+                if (a < 0x80)
+                    continue;
+                /* premultiplied: undo it before judging brightness */
+                lum = (((p >> 16) & 0xff) * 30 + ((p >> 8) & 0xff) * 59 +
+                       (p & 0xff) * 11) / 100 * 255 / a;
+                setPixel(pixels, stride, x, y, lum >= 0xaa ? 1 : lum <= 0x55 ? 2 : 3);
+            }
+    }
+    else {
+        int src_stride = BitmapBytePad(bits->width);
+
+        colours[0] = paletteWord(cursor->backRed, cursor->backGreen,
+                                 cursor->backBlue);
+        colours[1] = paletteWord(cursor->foreRed, cursor->foreGreen,
+                                 cursor->foreBlue);
+        colours[2] = colours[1];
+        rc->area = makeSprite(w, h, colours, &pixels, &stride);
+        if (!rc->area)
+            return FALSE;
+        for (y = 0; y < h; y++)
+            for (x = 0; x < w; x++) {
+                if (!bitAt(bits->mask, src_stride, x + x0, y + y0))
+                    continue;
+                setPixel(pixels, stride, x, y,
+                         bitAt(bits->source, src_stride, x + x0, y + y0) ? 2 : 1);
+            }
+    }
+    return TRUE;
+}
+
+static Bool
+riscosUnrealizeCursor(DeviceIntPtr dev, ScreenPtr screen, CursorPtr cursor)
+{
+    RiscosCursor *rc = cursorPriv(cursor);
+
+    if (current == rc)
+        current = &blank;
+    free(rc->area);
+    rc->area = NULL;
+    return TRUE;
+}
+
+/* Make the current X cursor the RISC OS pointer. */
+static void
+applyCursor(void)
+{
+    RiscosCursor *rc = current && current->area ? current : &blank;
+
+    if (!rc->area)
+        return;
+    /* r3: shape number, and set both shape and palette */
+    _swix(OS_SpriteOp, _INR(0, 7), 36 + 512, rc->area, rc->area + 4,
+          PTR_SHAPE, rc->hotx, rc->hoty, 0, 0);
+    showing = 1;
+}
+
+static void
+riscosSetCursor(DeviceIntPtr dev, ScreenPtr screen, CursorPtr cursor,
+                int x, int y)
+{
+    current = cursor ? cursorPriv(cursor) : &blank;
+    if (showing)
+        applyCursor();
+}
+
+static void
+riscosMoveCursor(DeviceIntPtr dev, ScreenPtr screen, int x, int y)
+{
+    /* The RISC OS pointer follows the mouse by itself. */
+}
+
+static Bool
+riscosDeviceCursorInitialize(DeviceIntPtr dev, ScreenPtr screen)
+{
+    return TRUE;
+}
+
+static void
+riscosDeviceCursorCleanup(DeviceIntPtr dev, ScreenPtr screen)
+{
+}
+
+static miPointerSpriteFuncRec riscosPointerSpriteFuncs = {
+    riscosRealizeCursor,
+    riscosUnrealizeCursor,
+    riscosSetCursor,
+    riscosMoveCursor,
+    riscosDeviceCursorInitialize,
+    riscosDeviceCursorCleanup
+};
+
+/* The pointer entered the X window: show X's cursor. */
+void
+riscosCursorEnter(int desk_xeig, int desk_yeig)
+{
+    xeig = desk_xeig;
+    yeig = desk_yeig;
+    applyCursor();
+}
+
+/* The pointer left the window, or the server is going: the Wimp's pointer
+   back, with its palette (the shapes share one). */
+void
+riscosCursorLeave(void)
+{
+    if (!showing)
+        return;
+    _swix(Wimp_SpriteOp, _IN(0) | _IN(2) | _INR(3, 7), 36, "ptr_default",
+          1, 0, 0, 0, 0);
+    showing = 0;
+}
+
+Bool
+riscosCursorInit(ScreenPtr pScreen)
+{
+    static int registered;
+    unsigned colours[3] = { 0, 0, 0 };
+    unsigned char *pixels;
+    int stride;
+
+    if (!registered) {
+        atexit(riscosCursorLeave);
+        registered = 1;
+    }
+    /* Pointer sprites are made at the desktop's resolution, so not scaled. */
+    _swix(OS_ReadModeVariable, _INR(0, 1) | _OUT(2), -1, 4, &xeig);
+    _swix(OS_ReadModeVariable, _INR(0, 1) | _OUT(2), -1, 5, &yeig);
+    if (!dixRegisterPrivateKey(&riscosCursorKey, PRIVATE_CURSOR,
+                               sizeof(RiscosCursor)))
+        return FALSE;
+    if (!blank.area)
+        blank.area = makeSprite(1, 1, colours, &pixels, &stride);
+    current = &blank;
+    return miPointerInitialize(pScreen, &riscosPointerSpriteFuncs,
+                               &kdPointerScreenFuncs, FALSE);
+}
--- a/hw/kdrive/riscos/riscosinit.c	1970-01-01 01:00:00.000000000 +0100
+++ b/hw/kdrive/riscos/riscosinit.c	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,150 @@
+/* Xriscos: kdrive entry points. Based on hw/kdrive/fake/fakeinit.c. */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include "riscos.h"
+#include <kernel.h>
+#include <swis.h>
+
+extern const char *kdGlobalXkbLayout;
+
+/* The XKB layout for the RISC OS keyboard setting (OS_Byte 71, 255 reads the
+   keyboard's territory number), unless -xkb-layout chose one. Only layouts
+   with a precompiled keymap (xkb/make-xkm.sh) are worth naming here. */
+static void
+riscosDefaultLayout(void)
+{
+    int keyboard = 0;
+
+    if (kdGlobalXkbLayout)
+        return;
+    _swix(OS_Byte, _INR(0, 1) | _OUT(1), 71, 255, &keyboard);
+    switch (keyboard) {
+    case 1:
+        kdGlobalXkbLayout = "gb";
+        break;
+    case 48:
+        kdGlobalXkbLayout = "us";
+        break;
+    default:
+        LogMessage(X_INFO, "RISC OS keyboard %d: using the us keymap; "
+                   "choose another with -xkb-layout\n", keyboard);
+        break;
+    }
+}
+
+Bool riscosCardInit(KdCardInfo * card);
+Bool riscosScreenInit(KdScreenInfo * screen);
+Bool riscosInitScreen(ScreenPtr pScreen);
+Bool riscosFinishInitScreen(ScreenPtr pScreen);
