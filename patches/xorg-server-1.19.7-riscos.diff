--- a/hw/kdrive/riscos/iconbar.c	1970-01-01 01:00:00.000000000 +0100
+++ b/hw/kdrive/riscos/iconbar.c	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,152 @@
+/*
+ * Xriscos: the icon bar icon and its menu.
+ *
+ * The icon is the X logo (xlogo.h, made by tools/mklogo.py), plotted from
+ * the server's own sprite area, so nothing needs loading into the Wimp's
+ * sprite pool. Select brings the X window to the front (opening it again if
+ * it was closed); Menu gives the usual icon bar menu: Fullscreen (ticked
+ * while it is), Rootless (ticked if the X server is to be rootless from its
+ * next start: an option saved between runs) and Quit. Adjust on a menu item leaves the menu open.
+ */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include <signal.h>
+#include <string.h>
+#include <kernel.h>
+#include <swis.h>
+#include "riscos.h"
+#include "xlogo.h"
+
+#define ICONBAR_RIGHT   (-1)    /* Wimp_CreateIcon: right-hand side */
+#define ICONBAR_WINDOW  (-2)    /* how clicks on the icon bar arrive */
+#define MENU_ITEM_H     44
+#define BUTTON_SELECT   4
+#define BUTTON_MENU     2
+#define BUTTON_ADJUST   1
+
+enum { ITEM_FULLSCREEN, ITEM_ROOTLESS, ITEM_QUIT, N_ITEMS };
+
+#define ITEM_TICKED     1
+#define ITEM_LAST       0x80
+#define ICON_SHADED     0x00400000
+
+typedef struct {
+    int flags, submenu, icon_flags;
+    char text[12];
+} MenuItem;
+
+static struct {
+    char title[12];
+    char title_fg, title_bg, work_fg, work_bg;
+    int width, height, gap;
+    MenuItem item[N_ITEMS];
+} menu;
+
+static int icon = -1;
+static int menu_x;
+static char logo_name[] = RISCOS_LOGO_NAME;
+
+static void
+setItem(int i, const char *text, int flags, Bool shaded)
+{
+    menu.item[i].flags = flags;
+    menu.item[i].submenu = -1;
+    /* text, filled, black on white */
+    menu.item[i].icon_flags = 0x07000021 | (shaded ? ICON_SHADED : 0);
+    strncpy(menu.item[i].text, text, sizeof menu.item[i].text);
+}
+
+static void
+openMenu(void)
+{
+    /* No full screen when rootless: there's no X screen to show */
+    setItem(ITEM_FULLSCREEN, "Fullscreen",
+            riscosIsFullscreen() ? ITEM_TICKED : 0, riscosRootless);
+    /* Ticked as saved, for the next start */
+    setItem(ITEM_ROOTLESS, "Rootless", riscosOptRootless ? ITEM_TICKED : 0,
+            FALSE);
+    setItem(ITEM_QUIT, "Quit", ITEM_LAST, FALSE);
+    _swix(Wimp_CreateMenu, _INR(1, 3), &menu, menu_x,
+          96 + MENU_ITEM_H * N_ITEMS);
+}
+
+void
+riscosIconbarInit(void)
+{
+    int block[9];
+    _kernel_oserror *e;
+
+    if (icon != -1)
+        return;
+    memset(&menu, 0, sizeof menu);
+    strncpy(menu.title, "X server", sizeof menu.title);
+    menu.title_fg = 7;
+    menu.title_bg = 2;
+    menu.work_fg = 7;
+    menu.work_bg = 0;
+    menu.width = 11 * 16;
+    menu.height = MENU_ITEM_H;
+    menu.gap = 0;
+
+    block[0] = ICONBAR_RIGHT;
+    block[1] = 0;
+    block[2] = 0;
+    block[3] = RISCOS_LOGO_SIZE * 2;    /* mode 20 pixels: 2 OS units */
+    block[4] = RISCOS_LOGO_SIZE * 2;
+    /* sprite, centred both ways, indirected, click button type */
+    block[5] = 0x2 | 0x8 | 0x10 | 0x100 | (3 << 12);
+    block[6] = (int) logo_name;
+    block[7] = (int) riscos_logo_area;
+    block[8] = (int) strlen(logo_name);
+    if ((e = _swix(Wimp_CreateIcon, _IN(1) | _OUT(0), block, &icon))) {
+        LogMessage(X_WARNING, "RISC OS: no icon bar icon: %s\n", e->errmess);
+        icon = -1;
+    }
+}
+
+/* A Mouse_Click; returns non-zero if X has something to do. */
+int
+riscosIconbarClick(int *block)
+{
+    if (block[3] != ICONBAR_WINDOW || block[4] != icon || icon == -1)
+        return 0;
+    switch (block[2]) {
+    case BUTTON_MENU:
+        menu_x = block[0] - 64;
+        openMenu();
+        return 0;
+    case BUTTON_SELECT:
+        riscosShowWindow();
+        return 0;
+    default:
+        return 0;
+    }
+}
+
+/* A Menu_Selection: block[0] is the item chosen. */
+int
+riscosMenuSelection(int *block)
+{
+    int pointer[5], woken = 0;
+
+    switch (block[0]) {
+    case ITEM_FULLSCREEN:
+        if (!riscosRootless)
+            woken = riscosToggleFullscreen();
+        break;
+    case ITEM_ROOTLESS:
+        riscosToggleRootless();
+        break;
+    case ITEM_QUIT:
+        LogMessage(X_INFO, "RISC OS: Quit chosen; shutting down\n");
+        GiveUp(SIGTERM);
+        return 1;
+    default:
+        return 0;
+    }
+    if (_swix(Wimp_GetPointerInfo, _IN(1), pointer) == NULL &&
+        (pointer[2] & BUTTON_ADJUST))
+        openMenu();
+    return woken;
+}
--- a/hw/kdrive/riscos/vcache.c	1970-01-01 01:00:00.000000000 +0100
+++ b/hw/kdrive/riscos/vcache.c	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,138 @@
+/*
+ * Xriscos: caching screen memory while X draws straight into it (full
+ * screen).
+ *
+ * RISC OS 3.7 maps screen memory bufferable but not cacheable. Writes are
+ * fast enough through the write buffer, but every read (CopyArea, scrolling,
+ * anything that blends) goes to VRAM a word at a time, and on a StrongARM
+ * that is far slower than reading cached memory, which comes in whole lines.
+ *
+ * So while X is running, between Wimp_Polls, the screen's pages are made
+ * cacheable (OS_Memory 0, cacheability control; it works on VRAM pages too).
+ * Just before each Wimp_Poll the data cache is cleaned, so what X drew
+ * reaches VRAM and the display, and the pages are made uncacheable again,
+ * so other tasks drawing on the screen meanwhile (menus, error boxes) are
+ * not held in the cache unseen.
+ *
+ * If AutoVCache is loaded, the screen is cacheable all the time and it
+ * cleans the cache now and then itself: then only the cleaning before each
+ * Wimp_Poll is done here, so X's drawing appears at once.
+ *
+ * -novcache turns all of this off.
+ */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include <stdlib.h>
+#include <kernel.h>
+#include <swis.h>
+#include "riscos.h"
+
+#define PAGE_SIZE       4096
+/* OS_Memory 0: logical addresses given; bits 14-15 cacheability control */
+#define MEM_LOGICAL     (1 << 9)
+#define MEM_UNCACHE     (2 << 14)
+#define MEM_CACHE       (3 << 14)
+
+Bool riscosVCacheEnabled = TRUE;
+
+static enum { VC_OFF, VC_TOGGLE, VC_CLEAN } vc_mode;
+static int *pages;              /* OS_Memory page blocks: 3 words each */
+static int npages;
+static int cached;              /* the pages are cacheable now */
+static unsigned long switches;
+
+static void
+cleanCache(void)
+{
+    /* The whole-cache form: cleans the data cache to memory. */
+    _swix(OS_SynchroniseCodeAreas, _IN(0), 0);
+}
+
+static void
+setCacheable(int on)
+{
+    _kernel_oserror *e;
+
+    if (on == cached)
+        return;
+    if (!on)
+        cleanCache();           /* nothing dirty may be left behind */
+    e = _swix(OS_Memory, _INR(0, 2),
+              MEM_LOGICAL | (on ? MEM_CACHE : MEM_UNCACHE), pages, npages);
+    if (e) {
+        LogMessage(X_WARNING, "RISC OS: cannot change the screen's caching "
+                   "(%s); drawing uncached\n", e->errmess);
+        vc_mode = VC_OFF;
+        return;
+    }
+    cached = on;
+    switches++;
+}
+
+/* X is drawing into bytes of screen memory from start. */
+void
+riscosVCacheStart(void *start, int bytes)
+{
+    unsigned long first = (unsigned long) start & ~(PAGE_SIZE - 1);
+    unsigned long end = ((unsigned long) start + bytes + PAGE_SIZE - 1) &
+        ~(PAGE_SIZE - 1);
+    int flags = 0, i;
+
+    riscosVCacheStop();
+    if (!riscosVCacheEnabled)
+        return;
+    if (_swix(OS_Module, _INR(0, 1) | _OUT(_FLAGS), 18, "AutoVCache",
+              &flags) == NULL) {
+        LogMessage(X_INFO, "RISC OS: AutoVCache is loaded; leaving the "
+                   "screen's caching to it\n");
+        vc_mode = VC_CLEAN;
+        return;
+    }
+    npages = (int) ((end - first) / PAGE_SIZE);
+    pages = calloc(npages, 3 * sizeof(int));
+    if (!pages)
+        return;
+    for (i = 0; i < npages; i++)
+        pages[3 * i + 1] = (int) (first + (unsigned long) i * PAGE_SIZE);
+    vc_mode = VC_TOGGLE;
+    switches = 0;
+    setCacheable(1);            /* X is running now */
+    if (vc_mode == VC_TOGGLE)
+        LogMessage(X_INFO, "RISC OS: screen memory cached while X draws "
+                   "(%d pages)\n", npages);
+}
+
+/* X no longer draws into screen memory. */
+void
+riscosVCacheStop(void)
+{
+    if (vc_mode == VC_TOGGLE)
+        setCacheable(0);
+    else if (vc_mode == VC_CLEAN)
+        cleanCache();
+    if (pages && switches)
+        LogMessage(X_INFO, "RISC OS: screen caching switched %lu times\n",
+                   switches);
+    free(pages);
+    pages = NULL;
+    npages = 0;
+    vc_mode = VC_OFF;
+}
+
+/* rwl's idle hook: idle is 1 just before Wimp_Poll, 0 just after. */
+void
+riscosVCacheIdle(int idle)
+{
+    switch (vc_mode) {
+    case VC_TOGGLE:
+        setCacheable(!idle);
+        break;
+    case VC_CLEAN:
+        if (idle)
+            cleanCache();
+        break;
+    default:
+        break;
+    }
+}
