+InitCard(char *name)
+{
+    KdCardInfoAdd(&riscosFuncs, 0);
+}
+
+void
+InitOutput(ScreenInfo * pScreenInfo, int argc, char **argv)
+{
+    KdInitOutput(pScreenInfo, argc, argv);
+}
+
+void
+InitInput(int argc, char **argv)
+{
+    KdPointerInfo *pi;
+    KdKeyboardInfo *ki;
+
+    riscosDefaultLayout();
+
+    pi = KdNewPointer();
+    if (!pi)
+        return;
+    pi->driver = &RiscosPointerDriver;
+    KdAddPointer(pi);
+
+    ki = KdNewKeyboard();
+    if (!ki)
+        return;
+    ki->driver = &RiscosKeyboardDriver;
+    KdAddKeyboard(ki);
+
+    KdInitInput();
+}
+
+void
+CloseInput(void)
+{
+    KdCloseInput();
+}
+
+#ifdef DDXBEFORERESET
+void
+ddxBeforeReset(void)
+{
+}
+#endif
+
+void
+ddxUseMsg(void)
+{
+    KdUseMsg();
+    ErrorF("\nXriscos options:\n");
+    ErrorF("-keylog                report each RISC OS key event and its mapping\n");
+}
+
+int
+ddxProcessArgument(int argc, char **argv, int i)
+{
+    if (!strcmp(argv[i], "-keylog")) {
+        riscosKeyLog = TRUE;
+        return 1;
+    }
+    return KdProcessArgument(argc, argv, i);
+}
+
+void
+OsVendorInit(void)
+{
+    KdOsInit(&RiscosOsFuncs);
+}
+
+KdCardFuncs riscosFuncs = {
+    riscosCardInit,             /* cardinit */
+    riscosScreenInit,           /* scrinit */
+    riscosInitScreen,           /* initScreen */
+    riscosFinishInitScreen,     /* finishInitScreen */
+    riscosCreateResources,      /* createRes */
+    riscosPreserve,             /* preserve */
+    riscosEnable,               /* enable */
+    riscosDPMS,                 /* dpms */
+    riscosDisable,              /* disable */
+    riscosRestore,              /* restore */
+    riscosScreenFini,           /* scrfini */
+    riscosCardFini,             /* cardfini */
+
+    riscosCursorInit,           /* initCursor: the RISC OS pointer */
+    0,                          /* enableCursor */
+    0,                          /* disableCursor */
+    0,                          /* finiCursor */
+    0,                          /* recolorCursor */
+
+    0,                          /* initAccel */
+    0,                          /* enableAccel */
+    0,                          /* disableAccel */
+    0,                          /* finiAccel */
+
+    riscosGetColors,            /* getColors */
+    riscosPutColors,            /* putColors */
+};
