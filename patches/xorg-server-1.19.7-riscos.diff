+/*
+ * Xriscos: the kdrive X server for the RISC OS desktop.
+ *
+ * The X screen is a RISC OS sprite that fb draws into directly, shown in a
+ * Wimp window. Changes reach the window through the shadow layer's damage
+ * tracking (Wimp_ForceRedraw); the Wimp's redraw requests plot the sprite.
+ * The server is a Wimp task through rwl (the port's evloop/), which delivers
+ * the Wimp events this driver handles.
+ */
+#ifndef _RISCOS_H_
+#define _RISCOS_H_
+#include <stdio.h>
+#include <unistd.h>
+#include "kdrive.h"
+#ifdef RANDR
+#include "randrstr.h"
+#endif
+
+typedef struct _riscosScrPriv {
+    Rotation randr;
+} RiscosScrPriv;
+
+extern KdCardFuncs riscosFuncs;
+extern KdPointerDriver RiscosPointerDriver;
+extern KdKeyboardDriver RiscosKeyboardDriver;
+extern KdOsFuncs RiscosOsFuncs;
+
+/* The pointer device, once enabled, for riscos.c to queue events on. */
+extern KdPointerInfo *riscosPointer;
+/* The keyboard device, once enabled. */
+extern KdKeyboardInfo *riscosKeyboard;
+
+/* Track the pointer over the window and queue X events for any change.
+   Returns non-zero if an event was queued. */
+int riscosPollPointer(void);
+
+/* The X cursor as the RISC OS pointer (cursor.c). */
+Bool riscosCursorInit(ScreenPtr pScreen);
+void riscosCursorEnter(int xeig, int yeig);
+void riscosCursorLeave(void);
+void riscosCursorResize(Bool on);       /* the resize cursor, or not */
+
+/* Pass keys queued by rwl's KeyV handler to X (kbd.c); release every key X
+   thinks is held, when the window loses the focus. Both return non-zero if
+   events were queued. */
+int riscosKeyEvents(void);
+/* -keylog: report every RISC OS key event and its mapping on stderr. */
+extern Bool riscosKeyLog;
+int riscosKeysReleaseAll(void);
+
+/* Full screen (riscos.c): X draws straight into screen memory. */
+int riscosIsFullscreen(void);
+/* Switch it on or off; returns non-zero if X has work to do. */
+int riscosToggleFullscreen(void);
+/* Bring the X window to the front, opening it if it was closed. */
+void riscosShowWindow(void);
+
+/* The icon bar icon and its menu (iconbar.c). The event functions return
+   non-zero if X has work to do. */
+void riscosIconbarInit(void);
+int riscosIconbarClick(int *block);
+int riscosMenuSelection(int *block);
+
+/* Rootless mode: each top-level X window a RISC OS window (rootless.c). */
+extern Bool riscosRootless;             /* this run */
+extern int riscosRootlessArg;           /* -rootless 1, -norootless 0, or -1 */
+Bool riscosRootlessInit(ScreenPtr pScreen);
+/* A Wimp event for a frame: -1 if it isn't one's, else non-zero if X has
+   work to do. */
+int riscosRootlessEvent(int reason, int *block);
+Bool riscosIsFrameWindow(int handle);
+void riscosFrameFocus(int handle);      /* it has the caret */
+void riscosFrameClick(int handle);      /* clicked: to the front */
+/* The resize corner: whether a desktop point is in it, and the drag */
+Bool riscosFrameCorner(int handle, int x, int y);
+void riscosFrameResizeDrag(int handle);
+void riscosRootlessModeChange(void);
+/* riscos.c, for rootless.c */
+void riscosFrameGone(int handle);
+void *riscosColourTable(void);
+/* The icon bar menu's Rootless item */
+void riscosToggleRootless(void);
+
+/* Options kept between runs (options.c). */
+extern Bool riscosOptRootless;
+void riscosOptionsLoad(void);
+Bool riscosOptionsSave(void);
+
+/* Caching screen memory while X draws into it (vcache.c). */
