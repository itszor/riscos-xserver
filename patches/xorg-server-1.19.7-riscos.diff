+    if (mode == RISCOS_UNSET) {
+        const char *why = "";
+
+        if (rwl_init("X server", &why) == 0) {
+            mode = RISCOS_WIMP;
+            for (i = 0; i < num; i++)
+                (void) rwl_watch_socket(fds[i].fd);
+            LogMessage(X_INFO, "RISC OS: running as a Wimp task\n");
+        } else {
+            mode = RISCOS_PLAIN;
+            LogMessage(X_WARNING, "RISC OS: not a Wimp task (%s); "
+                       "using plain poll()\n", why);
