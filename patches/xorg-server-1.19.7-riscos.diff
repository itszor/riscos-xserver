--- a/hw/kdrive/riscos/rootless.c	1970-01-01 01:00:00.000000000 +0100
+++ b/hw/kdrive/riscos/rootless.c	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,912 @@
+/*
+ * Xriscos rootless mode: each top-level X window is a RISC OS window.
+ *
+ * Built on the generic rootless layer (miext/rootless), which gives every
+ * mapped top-level window a "frame" with its own backing buffer and calls
+ * the functions here to create, move, resize, restack and redisplay it.
+ * Here a frame is a Wimp window and a sprite: fb draws into the sprite (in
+ * the X screen's pixel format, as the rooted mode's framebuffer is), the
+ * layer's updates become Wimp_ForceRedraw, and redraw requests plot it.
+ *
+ * The Wimp is the window manager, on the ARM, so that no X window manager
+ * has to run on the PC or talk over the network: a frame for an ordinary
+ * window has a title bar (WM_NAME), back, close, toggle-size and size icons;
+ * one for an override-redirect window (a menu, a tooltip) has none. When
+ * the user moves, resizes, raises or lowers a frame, the X window follows
+ * (ConfigureWindow, as XWin's -mwextwm does); closing one asks the client
+ * to delete it (WM_DELETE_WINDOW) or, failing that, disconnects it;
+ * clicking one gives it the caret and the X input focus.
+ *
+ * The X root window is the size of the desktop and is never shown; X
+ * coordinates are desktop pixels, from the top left.
+ */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include <stdlib.h>
+#include <string.h>
+#include <kernel.h>
+#include <swis.h>
+#include <X11/Xatom.h>
+#include "riscos.h"
+#include "rootless.h"
+#include "windowstr.h"
+#include "propertyst.h"
+#include "inputstr.h"
+#include "xace.h"
+#include "xacestr.h"
+
+/* Wimp event reason codes */
+#define Redraw_Window_Request   1
+#define Open_Window_Request     2
+#define Close_Window_Request    3
+
+#define WIMP_TOP        (-1)    /* Wimp_OpenWindow "behind": on top */
+#define WIMP_BOTTOM     (-2)    /*   at the bottom */
+#define TITLE_LEN       128
+#define MAX_REDRAW_BOXES 16
+
+/* Window flags: new-style, moveable, with back, close, title, toggle-size
+   and size icons; or none of them, for override-redirect windows. RISC OS
+   3.7 shows the size icon only beside a scroll bar, which an X window has
+   no use for, so there it doesn't appear: a drag from the window's bottom
+   right corner (CORNER_PIXELS) resizes it instead, as the icon would. */
+#define FLAGS_DECORATED 0xaf000002u
+#define CORNER_PIXELS   8
+#define DRAG_SIZE       2       /* Wimp_DragBox: the window's size */
+#define FLAGS_PLAIN     0x80000000u
+
+typedef struct RiscosFrame {
+    struct RiscosFrame *next;
+    RootlessWindowPtr rl;       /* the layer's frame record */
+    int handle;                 /* Wimp window */
+    int *area;                  /* sprite area with one sprite */
+    int *sprite;
+    CARD8 *pixels;
+    int stride;
+    int w, h;                   /* the sprite's size, pixels */
+    int x, y;                   /* the frame's position, X pixels */
+    Bool decorated;
+    Bool open;                  /* the Wimp window is open */
+    Bool title_stale;           /* WM_NAME may have changed */
+    RegionRec damage;           /* drawn on since the last flush */
+    char title[TITLE_LEN];
+} RiscosFrame;
+
+static RiscosFrame *frames;
+static ScreenPtr frame_screen;
+
+static WindowPtr
+rd_root(void)
+{
+    return frame_screen ? frame_screen->root : NULL;
+}
+static int screen_bpp;
+/* Set while the X window is being made to follow its frame (the user
+   moved it): the frame functions then leave the Wimp window alone. */
+static int native_change;
+static Atom atom_net_wm_name, atom_utf8, atom_wm_protocols,
+    atom_wm_delete_window;
+static Bool title_work_queued;
+
+static void raiseOverrides(void);
+
+/* ---- Geometry ---- */
+
+static int
+modeVar(int var)
+{
+    int value = 0;
+
+    _swix(OS_ReadModeVariable, _INR(0, 1) | _OUT(2), -1, var, &value);
+    return value;
+}
+
+static int xeig(void) { return modeVar(4); }
+static int yeig(void) { return modeVar(5); }
+/* The desktop's height, OS units */
+static int deskHeight(void) { return (modeVar(12) + 1) << yeig(); }
+
+/* The Wimp visible area for a frame at x, y, w x h X pixels */
+static void
+frameVisible(int x, int y, int w, int h, int vis[4])
+{
+    int xe = xeig(), ye = yeig(), top = deskHeight();
+
+    vis[0] = x << xe;
+    vis[1] = top - ((y + h) << ye);
+    vis[2] = (x + w) << xe;
+    vis[3] = top - (y << ye);
+}
+
+static RiscosFrame *
+frameForHandle(int handle)
+{
+    RiscosFrame *f;
+
+    for (f = frames; f; f = f->next)
+        if (f->handle == handle)
+            return f;
+    return NULL;
+}
+
+Bool
+riscosIsFrameWindow(int handle)
+{
+    return handle > 0 && frameForHandle(handle) != NULL;
+}
+
+/* ---- The sprite ---- */
+
+static Bool
+frameSprite(RiscosFrame *f, int w, int h)
+{
+    int stride, image, total, *area, *s;
+    int xdpi = 180 >> xeig(), ydpi = 180 >> yeig();
+
+    if (w < 1)
+        w = 1;
+    if (h < 1)
+        h = 1;
+    if (f->area && f->w == w && f->h == h)
+        return TRUE;
+    stride = ((w * screen_bpp + 31) >> 5) << 2;
+    image = stride * h;
+    total = 16 + 44 + image;
+    area = malloc(total);
+    if (!area)
+        return FALSE;
+    /* Black to start with: a window with no background shows what's here
+       until its client draws (malloc's memory could be an old frame's). */
+    memset(area, 0, total);
+    area[0] = total;
+    area[1] = 1;
+    area[2] = 16;
+    area[3] = total;
+    s = area + 4;
+    s[0] = 44 + image;
+    memset(&s[1], 0, 12);
+    strcpy((char *) &s[1], "frame");
+    s[4] = stride / 4 - 1;
+    s[5] = h - 1;
+    s[6] = 0;
+    s[7] = (w * screen_bpp - 1) & 31;
+    s[8] = 44;
+    s[9] = 44;
+    s[10] = ((screen_bpp == 32 ? 6 : 5) << 27) | (ydpi << 14) |
+        (xdpi << 1) | 1;
+    free(f->area);
+    f->area = area;
+    f->sprite = s;
+    f->pixels = (CARD8 *) s + 44;
+    f->stride = stride;
+    f->w = w;
+    f->h = h;
+    return TRUE;
+}
+
+/* ---- The Wimp window ---- */
+
+static void
+frameExtent(RiscosFrame *f)
+{
+    int ext[4];
+    int sw = (modeVar(11) + 1) << xeig(), sh = deskHeight();
+    int w = f->w << xeig(), h = f->h << yeig();
+
+    ext[0] = 0;
+    ext[1] = -(h > sh ? h : sh);
+    ext[2] = w > sw ? w : sw;
+    ext[3] = 0;
+    _swix(Wimp_SetExtent, _INR(0, 1), f->handle, ext);
+}
+
+static Bool
+frameCreateWindow(RiscosFrame *f)
+{
+    int block[23];
+    _kernel_oserror *e;
+
+    memset(block, 0, sizeof block);
+    frameVisible(f->x, f->y, f->w, f->h, block);
+    block[6] = WIMP_TOP;
+    block[7] = (int) (f->decorated ? FLAGS_DECORATED : FLAGS_PLAIN);
+    ((char *) block)[32] = 7;           /* title foreground */
+    ((char *) block)[33] = 2;           /* title background */
+    ((char *) block)[34] = 7;
+    ((char *) block)[35] = (char) 0xff; /* work area: we paint it all */
+    ((char *) block)[36] = 3;
+    ((char *) block)[37] = 1;
+    ((char *) block)[38] = 12;          /* title background with focus */
+    block[11] = -(f->h << yeig());
+    block[12] = f->w << xeig();
+    block[14] = f->decorated ? 0x13d : 0;       /* indirected text title */
+    block[15] = 10 << 12;               /* work area: click/drag */
+    block[16] = 1;
+    block[17] = (1 << xeig()) | ((1 << yeig()) << 16);  /* minimum size */
+    block[18] = (int) f->title;
+    block[19] = -1;
+    block[20] = TITLE_LEN;
+    block[21] = 0;
+    if ((e = _swix(Wimp_CreateWindow, _IN(1) | _OUT(0), block, &f->handle))) {
+        LogMessage(X_ERROR, "RISC OS: cannot create a window: %s\n",
+                   e->errmess);
+        f->handle = 0;
+        return FALSE;
+    }
+    frameExtent(f);
+    return TRUE;
+}
+
+/* Open (or reopen) the window where the frame is, behind the given window
+   (WIMP_TOP, or -3 to keep its place). */
+static void
+frameOpen(RiscosFrame *f, int behind)
+{
+    int block[9];
+
+    block[0] = f->handle;
+    if (behind == -3) {
+        if (_swix(Wimp_GetWindowState, _IN(1), block) != NULL)
+            return;
+        behind = (block[8] & (1 << 16)) ? block[7] : WIMP_TOP;
+    }
+    frameVisible(f->x, f->y, f->w, f->h, &block[1]);
+    block[5] = 0;
+    block[6] = 0;
+    block[7] = behind;
+    _swix(Wimp_OpenWindow, _IN(1), block);
+    f->open = TRUE;
+}
+
+/* The X position of a frame's window as the Wimp has it, which may differ
+   from where X put it: the Wimp keeps windows on the screen. */
+static void
+frameReadPosition(RiscosFrame *f, int *x, int *y, int *w, int *h)
+{
+    int block[9];
+
+    block[0] = f->handle;
+    *x = f->x;
+    *y = f->y;
+    *w = f->w;
+    *h = f->h;
+    if (_swix(Wimp_GetWindowState, _IN(1), block) != NULL)
+        return;
+    *x = block[1] >> xeig();
+    *y = (deskHeight() - block[4]) >> yeig();
+    *w = (block[3] - block[1]) >> xeig();
+    *h = (block[4] - block[2]) >> yeig();
+}
+
+/* ---- Making X follow ---- */
+
+/* Configure the frame's X window to the Wimp window's geometry, and
+   restack it if asked (Above, Below, or -1 not). */
+static void
+frameConfigureX(RiscosFrame *f, int stack)
+{
+    WindowPtr win = f->rl->win;
+    int x, y, w, h, bw = wBorderWidth(win), n = 0;
+    XID vlist[5];
+    Mask mask = 0;
+
+    frameReadPosition(f, &x, &y, &w, &h);
+    if (x != f->rl->x || y != f->rl->y) {
+        mask |= CWX | CWY;
+        vlist[n++] = x;
+        vlist[n++] = y;
+    }
+    if (w != (int) f->rl->width || h != (int) f->rl->height) {
+        mask |= CWWidth | CWHeight;
+        vlist[n++] = w - 2 * bw > 0 ? w - 2 * bw : 1;
+        vlist[n++] = h - 2 * bw > 0 ? h - 2 * bw : 1;
+    }
+    if (stack >= 0) {
+        mask |= CWStackMode;
+        vlist[n++] = stack;
+    }
+    if (!mask)
+        return;
+    native_change++;
+    ConfigureWindow(win, mask, vlist, wClient(win));
+    native_change--;
+}
+
+/* A work procedure: X moves frames the Wimp didn't put where X asked. */
+static Bool
+syncWork(ClientPtr client, void *closure)
+{
+    RiscosFrame *f;
+
+    for (f = frames; f; f = f->next)
+        if (f->open && f->rl && f->rl->win) {
+            int x, y, w, h;
+
+            frameReadPosition(f, &x, &y, &w, &h);
+            if (x != f->rl->x || y != f->rl->y)
+                frameConfigureX(f, -1);
+        }
+    return TRUE;
+}
+
+static void
+queueSync(void)
+{
+    QueueWorkProc(syncWork, serverClient, NULL);
+}
+
+/* ---- Titles ---- */
+
+/* WM_NAME, or _NET_WM_NAME (UTF-8, here as Latin-1 where it can be) */
+static void
+frameReadTitle(RiscosFrame *f)
+{
+    WindowPtr win = f->rl ? f->rl->win : NULL;
+    PropertyPtr prop;
+    const unsigned char *s;
+    char *d = f->title;
+    int n, i;
+    Bool utf8 = FALSE;
+
+    f->title_stale = FALSE;
+    f->title[0] = '\0';
+    if (!win)
+        return;
+    if (dixLookupProperty(&prop, win, atom_net_wm_name, serverClient,
+                          DixReadAccess) == Success &&
+        prop->format == 8 && prop->type == atom_utf8)
+        utf8 = TRUE;
+    else if (dixLookupProperty(&prop, win, XA_WM_NAME, serverClient,
+                               DixReadAccess) != Success ||
+             prop->format != 8)
+        return;
+    s = prop->data;
+    n = prop->size;
+    for (i = 0; i < n && d < f->title + TITLE_LEN - 1; i++) {
+        unsigned c = s[i];
+
+        if (utf8 && c >= 0x80) {
+            /* two-byte sequences for U+0080-U+00FF; else '?' */
+            if ((c == 0xC2 || c == 0xC3) && i + 1 < n) {
+                c = ((c & 0x1F) << 6) | (s[++i] & 0x3F);
+            } else {
+                while (i + 1 < n && (s[i + 1] & 0xC0) == 0x80)
+                    i++;
+                c = '?';
+            }
+        }
+        if (c < 0x20)
+            c = ' ';
+        *d++ = (char) c;
+    }
+    *d = '\0';
+}
+
+static void
+frameRedrawTitle(RiscosFrame *f)
+{
+    int block[9];
+
+    if (!f->open || !f->decorated)
+        return;
+    block[0] = f->handle;
+    if (_swix(Wimp_GetWindowState, _IN(1), block) != NULL)
+        return;
+    /* the title bar is above the visible area: 48 OS units is enough */
+    _swix(Wimp_ForceRedraw, _INR(0, 4), -1, block[1], block[4],
+          block[3], block[4] + 48);
+}
+
+static Bool
+titleWork(ClientPtr client, void *closure)
+{
+    RiscosFrame *f;
+
+    title_work_queued = FALSE;
+    for (f = frames; f; f = f->next)
+        if (f->title_stale) {
+            char old[TITLE_LEN];
+
+            strcpy(old, f->title);
+            frameReadTitle(f);
+            if (strcmp(old, f->title))
+                frameRedrawTitle(f);
+        }
+    return TRUE;
+}
+
+/* XACE: a property is about to be read or changed. If it's a title, look
+   at it again once the request is done. */
+static void
+propertyAccess(CallbackListPtr *pcbl, void *data, void *calldata)
+{
+    XacePropertyAccessRec *rec = calldata;
+    PropertyPtr prop = *rec->ppProp;
+    RiscosFrame *f;
+
+    if (!(rec->access_mode & (DixWriteAccess | DixBlendAccess |
+                              DixCreateAccess | DixDestroyAccess)) ||
+        !prop || !rec->pWin || !rec->pWin->parent ||
+        rec->pWin->parent->parent ||    /* top-level windows only */
+        (prop->propertyName != XA_WM_NAME &&
+         prop->propertyName != atom_net_wm_name))
+        return;
+    for (f = frames; f; f = f->next)
+        if (f->rl && f->rl->win == rec->pWin) {
+            f->title_stale = TRUE;
+            if (!title_work_queued) {
+                title_work_queued = TRUE;
+                QueueWorkProc(titleWork, serverClient, NULL);
+            }
+        }
+}
+
+/* ---- The rootless layer's frame functions ---- */
+
+static Bool
+riscosCreateFrame(RootlessWindowPtr pFrame, ScreenPtr pScreen,
+                  int newX, int newY, RegionPtr pNewShape)
+{
+    RiscosFrame *f = calloc(1, sizeof *f);
+
+    if (!f)
+        return FALSE;
+    f->rl = pFrame;
+    f->x = newX;
+    f->y = newY;
+    f->decorated = !pFrame->win->overrideRedirect;
+    RegionNull(&f->damage);
+    if (!frameSprite(f, pFrame->width, pFrame->height)) {
+        free(f);
+        return FALSE;
+    }
+    frameReadTitle(f);
+    if (!frameCreateWindow(f)) {
+        free(f->area);
+        free(f);
+        return FALSE;
+    }
+    f->next = frames;
+    frames = f;
+    pFrame->wid = (RootlessFrameID) f;
+    return TRUE;
+}
+
+static void
+riscosDestroyFrame(RootlessFrameID wid)
+{
+    RiscosFrame *f = (RiscosFrame *) wid, **pp;
+
+    for (pp = &frames; *pp; pp = &(*pp)->next)
+        if (*pp == f) {
+            *pp = f->next;
+            break;
+        }
+    if (f->handle) {
+        _swix(Wimp_CloseWindow, _IN(1), &f->handle);
+        _swix(Wimp_DeleteWindow, _IN(1), &f->handle);
+    }
+    riscosFrameGone(f->handle);
+    RegionUninit(&f->damage);
+    free(f->area);
+    free(f);
+}
+
+static void
+riscosMoveFrame(RootlessFrameID wid, ScreenPtr pScreen, int newX, int newY)
+{
+    RiscosFrame *f = (RiscosFrame *) wid;
+
+    f->x = newX;
+    f->y = newY;
+    if (f->open && !native_change) {
+        frameOpen(f, -3);
+        queueSync();
+    }
+}
+
+static void
+riscosResizeFrame(RootlessFrameID wid, ScreenPtr pScreen, int newX, int newY,
+                  unsigned int newW, unsigned int newH, unsigned int gravity)
+{
+    RiscosFrame *f = (RiscosFrame *) wid;
+
+    f->x = newX;
+    f->y = newY;
+    /* The layer puts back what the window had, after this. */
+    if (!frameSprite(f, newW, newH))
+        LogMessage(X_ERROR, "RISC OS: no memory for a %ux%u window\n",
+                   newW, newH);
+    frameExtent(f);
+    if (f->open && !native_change) {
+        frameOpen(f, -3);
+        queueSync();
+    }
+    if (f->open)
+        _swix(Wimp_ForceRedraw, _INR(0, 4), f->handle, 0,
+              -(f->h << yeig()), f->w << xeig(), 0);
+}
+
+static void
+riscosRestackFrame(RootlessFrameID wid, RootlessFrameID nextWid)
+{
+    RiscosFrame *f = (RiscosFrame *) wid, *above = (RiscosFrame *) nextWid;
+
+    if (native_change && f->open)
+        return;                 /* the Wimp has it already */
+    frameOpen(f, above && above->open ? above->handle : WIMP_TOP);
+    queueSync();
+}
+
+static void
+riscosReshapeFrame(RootlessFrameID wid, RegionPtr pNewShape)
+{
+    /* RISC OS 3.7 windows are rectangles: shaped windows show whole. */
+}
+
+static void
+riscosUnmapFrame(RootlessFrameID wid)
+{
+    RiscosFrame *f = (RiscosFrame *) wid;
+
+    if (f->open)
+        _swix(Wimp_CloseWindow, _IN(1), &f->handle);
+    f->open = FALSE;
+    riscosFrameGone(f->handle);
+}
+
+static void
+riscosStartDrawing(RootlessFrameID wid, char **pixelData, int *bytesPerRow)
+{
+    RiscosFrame *f = (RiscosFrame *) wid;
+
+    *pixelData = (char *) f->pixels;
+    *bytesPerRow = f->stride;
+}
+
+/* The layer's flush comes here when the frame was being drawn on, and to
+   UpdateRegion(NULL) when it wasn't. */
+static void frameFlush(RiscosFrame *f);
+
+static void
+riscosStopDrawing(RootlessFrameID wid, Bool flush)
+{
+    if (flush)
+        frameFlush((RiscosFrame *) wid);
+}
+
+/* The frame's damage, flushed: Wimp_ForceRedraw for each box, or their
+   extent when there are many. */
+static void
+frameFlush(RiscosFrame *f)
+{
+    int xe = xeig(), ye = yeig();
+    int n = RegionNumRects(&f->damage);
+    BoxPtr box = RegionRects(&f->damage);
+
+    if (n == 0)
+        return;
+    if (f->open) {
+        if (n > MAX_REDRAW_BOXES) {
+            box = RegionExtents(&f->damage);
+            n = 1;
+        }
+        while (n--) {
+            _swix(Wimp_ForceRedraw, _INR(0, 4), f->handle,
+                  box->x1 << xe, -(box->y2 << ye),
+                  box->x2 << xe, -(box->y1 << ye));
+            box++;
+        }
+    }
+    RegionEmpty(&f->damage);
+}
+
+/* The layer says what was drawn on (DamageRects), and when to show it
+   (UpdateRegion, with NULL for "what you've been told"). */
+static void
+riscosUpdateRegion(RootlessFrameID wid, RegionPtr pDamage)
+{
+    RiscosFrame *f = (RiscosFrame *) wid;
+
+    if (pDamage)
+        RegionUnion(&f->damage, &f->damage, pDamage);
+    frameFlush(f);
+}
+
+static void
+riscosDamageRects(RootlessFrameID wid, int nrects, const BoxRec *rects,
+                  int shift_x, int shift_y)
+{
+    RiscosFrame *f = (RiscosFrame *) wid;
+
+    while (nrects--) {
+        BoxRec box;
+        RegionRec r;
+
+        box.x1 = rects->x1 + shift_x;
+        box.y1 = rects->y1 + shift_y;
+        box.x2 = rects->x2 + shift_x;
+        box.y2 = rects->y2 + shift_y;
+        rects++;
+        if (box.x1 >= box.x2 || box.y1 >= box.y2)
+            continue;
+        RegionInit(&r, &box, 1);
+        RegionUnion(&f->damage, &f->damage, &r);
+        RegionUninit(&r);
+    }
+}
+
+static void
+riscosSwitchWindow(RootlessWindowPtr pFrame, WindowPtr oldWin)
+{
+    RiscosFrame *f = (RiscosFrame *) pFrame->wid;
+
+    f->rl = pFrame;
+    frameReadTitle(f);
+    frameRedrawTitle(f);
+}
+
+static RootlessFrameProcsRec riscosFrameProcs = {
+    riscosCreateFrame,
+    riscosDestroyFrame,
+    riscosMoveFrame,
+    riscosResizeFrame,
+    riscosRestackFrame,
+    riscosReshapeFrame,
+    riscosUnmapFrame,
+    riscosStartDrawing,
+    riscosStopDrawing,
+    riscosUpdateRegion,
+    riscosDamageRects,
+    riscosSwitchWindow,
+    NULL,                       /* DoReorderWindow */
+    NULL,                       /* HideWindow */
+    NULL,                       /* UpdateColormap */
+    NULL,                       /* CopyBytes: fb's */
+    NULL,                       /* CopyWindow: fb's */
+};
+
+/* ---- Wimp events for frames ---- */
+
+static void
+frameRedraw(RiscosFrame *f, int *block)
+{
+    int more = 0;
+    _kernel_oserror *e = _swix(Wimp_RedrawWindow, _IN(1) | _OUT(0), block,
+                               &more);
+    void *table = riscosColourTable();
+
+    while (e == NULL && more) {
+        int ox = block[1] - block[5], oy = block[4] - block[6];
+        int right = ox + (f->w << xeig()), bottom = oy - (f->h << yeig());
+
+        _swix(OS_SpriteOp, _INR(0, 7), 52 + 512, f->area, f->sprite,
+              ox, bottom, 0, 0, table);
+        /* Where the window is bigger than the sprite (being resized),
+           black. block[7-10] is the graphics window. */
+        if (block[9] >= right || block[8] < bottom) {
+            _swix(ColourTrans_SetGCOL, _IN(0) | _INR(3, 4), 0, 0, 0);
+            if (block[9] >= right) {
+                _swix(OS_Plot, _INR(0, 2), 4, right, block[8]);
+                _swix(OS_Plot, _INR(0, 2), 96 + 5, block[9], block[10]);
+            }
+            if (block[8] < bottom) {
+                _swix(OS_Plot, _INR(0, 2), 4, block[7], block[8]);
+                _swix(OS_Plot, _INR(0, 2), 96 + 5, block[9], bottom - 1);
+            }
+        }
+        e = _swix(Wimp_GetRectangle, _IN(1) | _OUT(0), block, &more);
+    }
+}
+
+/* The user moved, resized, raised or lowered a frame: the Wimp window
+   goes where asked, and the X window follows. */
+static void
+frameOpenRequest(RiscosFrame *f, int *block)
+{
+    int behind = block[7], stack = -1;
+
+    block[5] = 0;               /* no scrolling: the work area is the window */
+    block[6] = 0;
+    _swix(Wimp_OpenWindow, _IN(1), block);
+    f->open = TRUE;
+    if (behind == WIMP_TOP)
+        stack = Above;
+    else if (behind == WIMP_BOTTOM)
+        stack = Below;
+    frameConfigureX(f, stack);
+    if (stack == Above && f->decorated)
+        raiseOverrides();
+}
+
+/* The close icon: WM_DELETE_WINDOW if the client takes it, as a window
+   manager would send; otherwise disconnect the client, as xkill does. */
+static void
+frameCloseRequest(RiscosFrame *f)
+{
+    WindowPtr win = f->rl ? f->rl->win : NULL;
+    PropertyPtr prop;
+    ClientPtr client;
+
+    if (!win)
+        return;
+    client = wClient(win);
+    if (dixLookupProperty(&prop, win, atom_wm_protocols, serverClient,
+                          DixReadAccess) == Success && prop->format == 32) {
+        CARD32 *atoms = prop->data;
+        int i;
+
+        for (i = 0; i < prop->size; i++)
+            if (atoms[i] == atom_wm_delete_window) {
+                xEvent ev;
+
+                memset(&ev, 0, sizeof ev);
+                ev.u.u.type = ClientMessage;
+                ev.u.u.detail = 32;
+                ev.u.clientMessage.window = win->drawable.id;
+                ev.u.clientMessage.u.l.type = atom_wm_protocols;
+                ev.u.clientMessage.u.l.longs0 = atom_wm_delete_window;
+                ev.u.clientMessage.u.l.longs1 = currentTime.milliseconds;
+                DeliverEventsToWindow(inputInfo.pointer, win, &ev, 1,
+                                      NoEventMask, NullGrab);
+                return;
+            }
+    }
+    if (client && client != serverClient && !client->clientGone) {
+        LogMessage(X_INFO, "RISC OS: closing a window that can't be "
+                   "deleted: disconnecting its client\n");
+        CloseDownClient(client);
+    }
+}
+
+/* The frame got the caret: X's input focus goes to its window. */
+void
+riscosFrameFocus(int handle)
+{
+    RiscosFrame *f = frameForHandle(handle);
+
+    if (!f || !f->rl || !f->rl->win || !f->decorated)
+        return;
+    SetInputFocus(serverClient, inputInfo.keyboard, f->rl->win->drawable.id,
+                  RevertToPointerRoot, CurrentTime, FALSE);
+}
+
+/* Override-redirect windows (menus, tooltips) stay above the others: after
+   a frame is raised, raise them again, in their X stacking order, on the
+   Wimp's stack and X's. */
+static void
+raiseOverrides(void)
+{
+    WindowPtr root = rd_root(), win;
+
+    if (!root)
+        return;
+    for (win = root->lastChild; win; win = win->prevSib) {
+        RiscosFrame *f;
+
+        for (f = frames; f; f = f->next)
+            if (f->rl && f->rl->win == win && !f->decorated && f->open) {
+                XID above = Above;
+
+                frameOpen(f, WIMP_TOP);
+                native_change++;
+                ConfigureWindow(win, CWStackMode, &above, wClient(win));
+                native_change--;
+            }
+    }
+}
+
+/* Whether a desktop point (OS units) is in a frame's resize corner: the
+   last CORNER_PIXELS of its bottom right, inside the window. */
+Bool
+riscosFrameCorner(int handle, int x, int y)
+{
+    RiscosFrame *f = frameForHandle(handle);
+    int block[9];
+
+    if (!f || !f->decorated || !f->open)
+        return FALSE;
+    block[0] = f->handle;
+    if (_swix(Wimp_GetWindowState, _IN(1), block) != NULL)
+        return FALSE;
+    return x >= block[3] - (CORNER_PIXELS << xeig()) && x < block[3] &&
+        y >= block[2] && y < block[2] + (CORNER_PIXELS << yeig());
+}
+
+/* A drag that began in the resize corner: the Wimp's own resize, as from
+   the size icon, whose Open_Window_Requests resize the X window. */
+void
+riscosFrameResizeDrag(int handle)
+{
+    int block[10];
+
+    memset(block, 0, sizeof block);
+    block[0] = handle;
+    block[1] = DRAG_SIZE;
+    _swix(Wimp_DragBox, _IN(1), block);
+}
+
+/* A click in a frame: to the front, as the title bar does. */
+void
+riscosFrameClick(int handle)
+{
+    RiscosFrame *f = frameForHandle(handle);
+    int block[9];
+
+    if (!f || !f->decorated)
+        return;
+    block[0] = f->handle;
+    if (_swix(Wimp_GetWindowState, _IN(1), block) != NULL ||
+        block[7] == WIMP_TOP)
+        return;
+    block[7] = WIMP_TOP;
+    frameOpenRequest(f, block);
+}
+
+/* Wimp events for frames. Returns -1 if the event isn't for one, else
+   non-zero if X has work to do. */
+int
+riscosRootlessEvent(int reason, int *block)
+{
+    RiscosFrame *f;
+
+    switch (reason) {
+    case Redraw_Window_Request:
+        if (!(f = frameForHandle(block[0])))
+            return -1;
+        frameRedraw(f, block);
+        return 0;
+    case Open_Window_Request:
+        if (!(f = frameForHandle(block[0])))
+            return -1;
+        frameOpenRequest(f, block);
+        return 1;
+    case Close_Window_Request:
+        if (!(f = frameForHandle(block[0])))
+            return -1;
+        frameCloseRequest(f);
+        return 1;
+    default:
+        return -1;
+    }
+}
+
+/* The desktop's mode changed: put every frame where X has it. */
+void
+riscosRootlessModeChange(void)
+{
+    RiscosFrame *f;
+
+    for (f = frames; f; f = f->next) {
+        frameExtent(f);
+        if (f->open)
+            frameOpen(f, -3);
+    }
+    queueSync();
+}
+
+/* ---- Setting up ---- */
+
+Bool
+riscosRootlessInit(ScreenPtr pScreen)
+{
+    KdScreenPriv(pScreen);
+
+    screen_bpp = pScreenPriv->screen->fb.bitsPerPixel;
+    frame_screen = pScreen;
+    if (!RootlessInit(pScreen, &riscosFrameProcs))
+        return FALSE;
+    /* fb's copies; there's nothing faster to call */
+    rootless_CopyBytes_threshold = 0;
+    rootless_CopyWindow_threshold = 0;
+    atom_net_wm_name = MakeAtom("_NET_WM_NAME", 12, TRUE);
+    atom_utf8 = MakeAtom("UTF8_STRING", 11, TRUE);
+    atom_wm_protocols = MakeAtom("WM_PROTOCOLS", 12, TRUE);
+    atom_wm_delete_window = MakeAtom("WM_DELETE_WINDOW", 16, TRUE);
+    if (!XaceRegisterCallback(XACE_PROPERTY_ACCESS, propertyAccess, NULL))
+        LogMessage(X_WARNING, "RISC OS: titles won't follow WM_NAME\n");
+    LogMessage(X_INFO, "RISC OS: rootless: each X window is a RISC OS "
+               "window\n");
+    return TRUE;
+}
