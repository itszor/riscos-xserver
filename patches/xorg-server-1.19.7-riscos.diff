+void riscosPreserve(KdCardInfo * card);
+Bool riscosEnable(ScreenPtr pScreen);
+Bool riscosDPMS(ScreenPtr pScreen, int mode);
+void riscosDisable(ScreenPtr pScreen);
+void riscosRestore(KdCardInfo * card);
+void riscosScreenFini(KdScreenInfo * screen);
+void riscosCardFini(KdCardInfo * card);
+void riscosGetColors(ScreenPtr pScreen, int n, xColorItem * pdefs);
+void riscosPutColors(ScreenPtr pScreen, int n, xColorItem * pdefs);
+
