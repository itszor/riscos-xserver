+        fclose(file);
+        provided = (need | XkmAllIndicesMask) & ~missing;
+        if (xkb && (need & provided) == need) {
+            LogMessage(X_INFO, "XKB: loaded precompiled keymap %s\n", path);
+            return xkb;
+        }
+        LogMessage(X_ERROR, "XKB: precompiled keymap %s is incomplete "
+                   "(missing 0x%x)\n", path, missing);
+        if (xkb)
+            XkbFreeKeyboard(xkb, 0, TRUE);
+    }
+    return NULL;
+}
